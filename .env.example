# Copy to `.env` and fill in. `.env` is gitignored.
#
# These are read by docker-compose.yml at container-start time and
# substituted into /usr/share/nginx/html/js/config.js. The image itself
# never needs to be rebuilt when you change them.

# The Odoo backend URL the storefront calls (no trailing slash).
# Examples:
#   http://localhost:8069                  # dev on the host
#   http://51.210.176.162:8069             # VPS validation
#   https://odoo.broderieroyale.com        # production
BR_API_BASE=http://localhost:8069

# The shared API key stored in Odoo at
#   Settings → Technical → System Parameters → coshift_ecomm_api.key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BR_API_KEY=unset-please-rotate-before-launch

# Public-facing port the container listens on (host-side). Anything that
# doesn't clash with Odoo (typically 8069 / 8072) or an existing nginx
# (80 / 443). For the initial client validation we agreed on 8080.
BR_PUBLIC_PORT=8080
