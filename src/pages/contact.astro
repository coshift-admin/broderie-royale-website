<script is:inline data-astro-rerun>
/* ---- mode toggle: Devis (default) ⇄ Nous écrire ----
   data-astro-rerun so this re-binds after every ClientRouter navigation.
   Without it, landing on /contact via the in-page nav left the toggle
   click listener un-attached and the "Nous écrire" tab silently failed.
   Guarded so repeat executions don't stack handlers. */
(function(){
  var toggle = document.getElementById('contactToggle');
  if (!toggle) return;
  var modes = Array.prototype.slice.call(document.querySelectorAll('.cmode'));
  function setMode(m, push){
    if (m !== 'devis' && m !== 'message') m = 'devis';
    modes.forEach(function(el){
      var on = el.dataset.mode === m;
      el.classList.toggle('on', on);
      el.classList.remove('anim');
      if (on && push) { void el.offsetWidth; el.classList.add('anim'); }
    });
    toggle.querySelectorAll('.ctab').forEach(function(b){ b.classList.toggle('active', b.dataset.mode === m); });
    if (push) { try { history.replaceState(null, '', '#' + m); } catch(e){} }
  }
  if (!toggle.dataset.bound) {
    toggle.dataset.bound = '1';
    toggle.addEventListener('click', function(e){
      var b = e.target.closest('.ctab'); if (!b) return; setMode(b.dataset.mode, true);
    });
  }
  var h = (location.hash || '').replace('#','').toLowerCase();
  if (h === 'message' || h === 'ecrire' || h === 'nous-ecrire') setMode('message', false);
  else setMode('devis', false);
})();

/* ---- Form validation regexes — shared by devis + contact ----
   PHONE_RE accepts Algerian formats: +213 followed by 9 digits, or a
   leading 0 followed by 9 digits. Spaces, dots and dashes between
   groups are stripped before the test. EMAIL_RE is a standard RFC-5322
   simplification that catches the common typos without rejecting valid
   addresses (a.b@c.d). */
var PHONE_RE = /^(?:\+213|0)\d{9}$/;
var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
function normPhone(s) { return (s || '').replace(/[\s\-.()]/g, ''); }
function lookupI18n(key) {
  var lang = (document.documentElement.getAttribute('lang') || 'fr').toLowerCase();
  if (lang === 'ar') lang = 'ar';
  else if (lang === 'en') lang = 'en';
  else lang = 'fr';
  var entry = (window.I18N || {})[key];
  if (!entry) return key;
  return entry[lang] || entry.fr || key;
}

/* ---- Devis: 3-step quote flow ---- */
(function(){
  var form=document.getElementById('devisForm'); if(!form) return;
  var steps=Array.prototype.slice.call(form.querySelectorAll('.devis-step'));
  var pips=Array.prototype.slice.call(document.querySelectorAll('#stepsRail .step-pip'));
  var sent=document.getElementById('devisSent');
  var cur=1;

  // Deadline picker: forbid past dates by setting min=today (YYYY-MM-DD).
  // Done in JS rather than at build time so the value stays correct
  // whichever day the page is visited.
  (function () {
    var d = form.querySelector('input[name="deadline"]');
    if (!d) return;
    var t = new Date();
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    d.min = t.getFullYear() + '-' + pad(t.getMonth() + 1) + '-' + pad(t.getDate());
  })();
  // Mount file-picker. file-picker.js is loaded at the end of <body>, so
  // when this inline script runs during body parse, window.BR_FilePicker
  // is undefined. Defer the mount until DOMContentLoaded (which fires
  // after all sync scripts at end-of-body have executed). On ClientRouter
  // SPA re-runs, readyState is already "complete" so we mount immediately.
  var picker = null;
  function mountDevisPicker() {
    var root = document.getElementById('devisFilePicker');
    if (!root) return;
    if (root.__brPicker) { picker = root.__brPicker; return; }
    if (window.BR_FilePicker) {
      picker = window.BR_FilePicker.attach({ root: root });
      root.__brPicker = picker;
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountDevisPicker, { once: true });
  } else {
    mountDevisPicker();
  }
  function go(n){ cur=n;
    steps.forEach(function(s){ var on=+s.dataset.step===n; s.classList.toggle('on', on); s.classList.remove('anim'); if(on){ void s.offsetWidth; s.classList.add('anim'); } });
    pips.forEach(function(p){ var k=+p.dataset.step; p.classList.toggle('active', k===n); p.classList.toggle('done', k<n); });
    var top=document.querySelector('.devis-card').getBoundingClientRect().top+window.scrollY-90;
    if(window.__lenis) window.__lenis.scrollTo(top,{duration:0.9}); else window.scrollTo({top:top,behavior:'smooth'});
  }
  document.getElementById('prodOptions').addEventListener('click',function(e){
    var o=e.target.closest('.prod-opt'); if(!o) return;
    document.querySelectorAll('.prod-opt').forEach(function(x){x.classList.remove('sel');});
    o.classList.add('sel'); document.getElementById('productVal').value=o.dataset.val;
    document.getElementById('err1').classList.remove('show');
  });
  function valid(n){
    if(n===1){ var ok=!!document.getElementById('productVal').value; document.getElementById('err1').classList.toggle('show',!ok); return ok; }
    if(n===2){ var q=form.qty.value.trim(); form.qty.classList.toggle('invalid',!q); var ok=!!q; document.getElementById('err2').classList.toggle('show',!ok); return ok; }
    if(n===3){
      var ok=true; var err3 = document.getElementById('err3'); var msg = '';
      // name and phone are required; email is optional (validated if filled).
      ['name','phone'].forEach(function(f){ var bad=!form[f].value.trim(); form[f].classList.toggle('invalid',bad); if(bad){ ok=false; msg = lookupI18n('dv.required'); } });
      var ph = normPhone(form.phone.value);
      if (ph && !PHONE_RE.test(ph)) { form.phone.classList.add('invalid'); ok=false; msg = lookupI18n('form.invalid_phone'); }
      var em = form.email.value.trim();
      if (em && !EMAIL_RE.test(em)) { form.email.classList.add('invalid'); ok=false; msg = lookupI18n('form.invalid_email'); }
      err3.textContent = msg || err3.textContent;
      err3.classList.toggle('show', !ok); return ok;
    }
    return true;
  }
  form.addEventListener('click',function(e){
    var nx=e.target.closest('[data-next]'); var pv=e.target.closest('[data-prev]');
    if(nx){ if(valid(cur)) go(+nx.dataset.next); }
    if(pv){ go(+pv.dataset.prev); }
  });
  form.querySelectorAll('input,textarea').forEach(function(f){ f.addEventListener('input',function(){ f.classList.remove('invalid'); }); });
  form.addEventListener('submit', async function(e){
    e.preventDefault();
    if (!valid(3)) return;
    var err3 = document.getElementById('err3');
    if (!window.BR_API) {
      err3.textContent = 'Service indisponible.'; err3.classList.add('show'); return;
    }
    var submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    var payload = {
      type: 'devis',
      name: form.name.value.trim(),
      phone: form.phone.value.trim(),
      email: form.email.value.trim(),
      product: document.getElementById('productVal').value || '',
      quantity: form.qty.value.trim(),
      branding: form.branding ? form.branding.value.trim() : '',
      deadline: form.deadline ? form.deadline.value.trim() : '',
    };
    var files = picker ? picker.files() : [];
    try {
      await window.BR_API.submitLead(payload, files);
      form.style.display='none';
      document.getElementById('stepsRail').style.display='none';
      sent.classList.add('show');
      var top=document.querySelector('.devis-card').getBoundingClientRect().top+window.scrollY-90;
      if(window.__lenis) window.__lenis.scrollTo(top,{duration:0.9});
    } catch (e) {
      console.error('[BR] devis submit failed', e);
      err3.textContent = (e && e.message) || 'Erreur d’envoi. Réessayez.';
      err3.classList.add('show');
      if (submitBtn) submitBtn.disabled = false;
    }
  });
})();

/* ---- message form + Algeria map ---- */
(function(){
  var form = document.getElementById('contactForm');
  var sent = document.getElementById('contactSent');
  var err = document.getElementById('cError');
  // Mount file-picker on the message form. Same DOMContentLoaded dance as
  // the devis picker above — file-picker.js loads at end-of-body.
  var picker = null;
  function mountContactPicker() {
    var root = document.getElementById('contactFilePicker');
    if (!root) return;
    if (root.__brPicker) { picker = root.__brPicker; return; }
    if (window.BR_FilePicker) {
      picker = window.BR_FilePicker.attach({ root: root });
      root.__brPicker = picker;
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountContactPicker, { once: true });
  } else {
    mountContactPicker();
  }
  form.addEventListener('submit', async function(e){
    e.preventDefault();
    var fields = form.querySelectorAll('[required]');
    var ok = true; var msg = '';
    fields.forEach(function(f){ var bad = !f.value.trim(); f.classList.toggle('invalid', bad); if(bad){ ok=false; msg = lookupI18n('ct.required'); } });
    var ph = normPhone(form.cPhone.value);
    if (ph && !PHONE_RE.test(ph)) { form.cPhone.classList.add('invalid'); ok=false; msg = lookupI18n('form.invalid_phone'); }
    var em = form.cEmail.value.trim();
    if (em && !EMAIL_RE.test(em)) { form.cEmail.classList.add('invalid'); ok=false; msg = lookupI18n('form.invalid_email'); }
    if (!ok) { err.textContent = msg || err.textContent; err.classList.add('show'); return; }
    err.classList.remove('show');
    if (!window.BR_API) {
      err.textContent = 'Service indisponible.'; err.classList.add('show'); return;
    }
    var submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    var payload = {
      type: 'contact',
      name: form.cName.value.trim(),
      phone: form.cPhone.value.trim(),
      email: form.cEmail.value.trim(),
      message: form.cMessage.value.trim(),
    };
    var files = picker ? picker.files() : [];
    try {
      await window.BR_API.submitLead(payload, files);
      form.style.display = 'none';
      sent.classList.add('show');
    } catch (ex) {
      console.error('[BR] contact submit failed', ex);
      err.textContent = (ex && ex.message) || 'Erreur d’envoi. Réessayez.';
      err.classList.add('show');
      if (submitBtn) submitBtn.disabled = false;
    }
  });
  form.querySelectorAll('[required]').forEach(function(f){ f.addEventListener('input', function(){ f.classList.remove('invalid'); }); });
  var map = document.querySelector('.alg-map');
  var wrap = document.querySelector('.map-wrap');
  var section = document.querySelector('.map-section');
  if (map && wrap && section) {
    var borders = map.querySelectorAll('.m-border');
    var wash = map.querySelector('.m-wash');
    var vanish = map.querySelector('.vanish');
    // Reveal order matches the map title sentence: Alger -> Boumerdès
    // -> Aïn Ouessara. Pin DOM order in the SVG stayed numeric
    // (pin1/2/3); only the staggered reveal sequence is reordered.
    var pins = [
      map.querySelector('.pin1'),
      map.querySelector('.pin3'),
      map.querySelector('.pin2')
    ].filter(Boolean);
    // The i-th label in #mapLabels matches the i-th pin above —
    // both are now in [Alger, Boumerdès, Aïn Ouessara] order.
    var labelEls = Array.prototype.slice.call(
      document.querySelectorAll('#mapLabels .map-label')
    );
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var FULL = [0, 0, 1000, 997];
    var ZOOM = [70, -50, 860, 320];
    function c01(v){ return v < 0 ? 0 : v > 1 ? 1 : v; }
    function seg(v, a, b){ return c01((v - a) / (b - a)); }
    function lerp(a, b, t){ return a + (b - a) * t; }
    // easeInOutCubic — used for border + zoom; smoother than linear into/out of
    // each scroll segment.
    function easeIO(t){ return t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2; }
    // easeOutBack — gentle overshoot for pin landing; gives the pin a "settle"
    // feel as it drops onto the map instead of clamping linearly.
    function easeOutBack(t){ var c = 1.40158; return 1 + (c + 1) * Math.pow(t - 1, 3) + c * Math.pow(t - 1, 2); }
    function easeOutCubic(t){ return 1 - Math.pow(1 - t, 3); }
    function setVB(t){ var v=[]; for (var j=0;j<4;j++) v.push(lerp(FULL[j], ZOOM[j], t).toFixed(2)); map.setAttribute('viewBox', v.join(' ')); }
    /* Smoothed scroll-driven update.
       The visual progress (displaySp) lerps toward the scroll-derived
       target (targetSp) every animation frame, so when the visitor
       throws the scroll wheel and the position jumps from 0.1 to 0.6
       in a single event, the map animates the in-between frames
       instead of snapping. Continues ticking until display has caught
       up, then idles. Earlier rAF-on-scroll setup snapped to the
       latest scroll position each frame, which is why fast scrolls
       skipped the animation. */
    var displaySp = -1;
    var targetSp = 0;
    var rafId = null;
    function readTarget() {
      var total = section.offsetHeight - window.innerHeight;
      var scrolled = -section.getBoundingClientRect().top;
      targetSp = total > 0 ? c01(scrolled / total) : 0;
    }
    function tick() {
      rafId = null;
      readTarget();
      if (displaySp < 0) displaySp = targetSp;
      var delta = targetSp - displaySp;
      displaySp += delta * 0.18;
      if (Math.abs(delta) < 0.0008) displaySp = targetSp;
      drawWithSp(displaySp);
      if (Math.abs(targetSp - displaySp) > 0.0002) {
        rafId = requestAnimationFrame(tick);
      }
    }
    // Phone test: viewBox attribute changes force an SVG reflow each
    // frame which jitters on lower-power mobile GPUs. Skip the zoom on
    // narrow viewports — map stays at its full extent throughout, but
    // borders/pins still animate. Smoother feel for the price of one
    // dropped effect.
    var smallScreen = matchMedia('(max-width: 720px)').matches;
    function drawWithSp(sp){
      // Border draw — finishes earlier so the eye doesn't sit on a
      // completed map waiting for pins. Previously ran 0 -> 0.42.
      var p = seg(sp, 0, 0.30);
      var dOff = (1 - easeOutCubic(p)).toFixed(4);
      for (var k = 0; k < borders.length; k++) borders[k].style.strokeDashoffset = dOff;
      var washIn = seg(p, 0.50, 1);
      wash.style.opacity = washIn.toFixed(3);
      if (!smallScreen) {
        // Zoom and vanish compressed and shifted earlier so the camera
        // settles before the pins arrive (no more "drawn map sits idle"
        // gap that used to span ~32% of the scroll).
        setVB(easeIO(seg(sp, 0.30, 0.55)));
      }
      var mAmt = seg(sp, 0.36, 0.60);
      vanish.style.opacity = mAmt.toFixed(3);
      // Pins start right as the zoom settles, then run staggered to the
      // end of the scroll. Total reveal window 0.45 -> 0.92; the last
      // ~0.08 of scroll is settle/idle before the section releases.
      var pinStart = 0.45;
      var pinSpan = 0.14;
      var pinStagger = 0.15;
      for (var i = 0; i < pins.length; i++){
        var raw = seg(sp, pinStart + i * pinStagger, pinStart + i * pinStagger + pinSpan);
        var lp = easeOutCubic(raw);
        var pin = pins[i];
        var mk = pin.querySelector('.marker');
        mk.style.opacity = lp.toFixed(3);
        mk.style.transform = 'translateY(' + ((1 - easeOutBack(raw)) * -10).toFixed(2) + 'px)';
        // Mirror the same reveal on the corresponding HTML label.
        if (labelEls[i]) {
          labelEls[i].style.opacity = lp.toFixed(3);
          labelEls[i].style.transform = 'translateX(' + ((1 - lp) * -16).toFixed(2) + 'px)';
        }
        if (raw > 0.95) pin.classList.add('placed'); else pin.classList.remove('placed');
      }
    }
    function onScroll(){ if (!rafId) rafId = requestAnimationFrame(tick); }
    if (reduce) {
      for (var k = 0; k < borders.length; k++) borders[k].style.strokeDashoffset = 0;
      wash.style.opacity = 1;
      setVB(1);
      vanish.style.opacity = 1;
      pins.forEach(function(pin){
        pin.querySelector('.marker').style.opacity = 1;
        pin.querySelector('.marker').style.transform = 'none';
        pin.classList.add('placed');
      });
      labelEls.forEach(function(el){ el.style.opacity = 1; el.style.transform = 'none'; });
    } else if (!map.dataset.bound) {
      // Idempotency: data-astro-rerun makes this IIFE execute on every
      // ClientRouter navigation, so guard against double-bound listeners
      // (otherwise the animation would tick multiple times per frame).
      map.dataset.bound = '1';
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    } else {
      // Re-render once on rerun so display catches the current scroll.
      onScroll();
    }
  }
})();
</script>
</BaseLayout>
