---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact — Broderie Royale Algérie"
  ogTitle="Contact — Broderie Royale Algérie"
  bodyClass="shop"
  dataPage="contact"
>
<link slot="head" rel="stylesheet" href="/contact.css" />

<header class="shop-hero">
  <div class="inner">
    <div class="eyebrow" data-i18n="ct.eyebrow">NOUS CONTACTER · MAISON DU DRAPEAU</div>
    <h1 data-i18n="ct.title">Parlons de votre projet.</h1>
    <p data-i18n="ct.sub">Une commande, un devis ou une simple question — écrivez-nous, nous vous répondrons rapidement.</p>
  </div>
</header>

<main>
  <div class="contact-body">

    <div class="contact-toggle" id="contactToggle">
      <button type="button" class="ctab active" data-mode="devis">
        <span class="ico"><svg viewBox="0 0 24 24"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/></svg></span>
        <span data-i18n="ct.tab_devis">Demander un devis</span>
      </button>
      <button type="button" class="ctab" data-mode="message">
        <span class="ico"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg></span>
        <span data-i18n="ct.tab_message">Nous écrire</span>
      </button>
    </div>

    <!-- ===== MODE · DEVIS (default) ===== -->
    <div class="cmode on" data-mode="devis">
      <div class="devis-grid">
        <div class="devis-card">
          <div class="steps-rail" id="stepsRail">
            <div class="step-pip active" data-step="1"><span class="num">1</span><span class="lab" data-i18n="dv.s1">Le produit</span></div>
            <div class="rail-line"></div>
            <div class="step-pip" data-step="2"><span class="num">2</span><span class="lab" data-i18n="dv.s2">Les détails</span></div>
            <div class="rail-line"></div>
            <div class="step-pip" data-step="3"><span class="num">3</span><span class="lab" data-i18n="dv.s3">Vos coordonnées</span></div>
          </div>

          <form id="devisForm" novalidate>
            <div class="devis-step on" data-step="1">
              <h2 data-i18n="dv.s1">Le produit</h2>
              <p class="step-hint" data-i18n="dv.product">Type de produit</p>
              <div class="prod-options" id="prodOptions">
                {/* Fallback French text inside each option so the cards
                    aren't blank during the brief window before i18n.js
                    runs and swaps in the right-language label. Without
                    these, the first paint showed empty boxes until the
                    visitor changed language and forced applyLang(). */}
                <div class="prod-opt" data-val="flags" data-i18n="dv.opt_flags">Drapeaux</div>
                <div class="prod-opt" data-val="crest" data-i18n="dv.opt_crest">Écussons brodés</div>
                <div class="prod-opt" data-val="pennant" data-i18n="dv.opt_pennant">Fanions</div>
                <div class="prod-opt" data-val="apparel" data-i18n="dv.opt_apparel">Broderie textile</div>
                <div class="prod-opt" data-val="print" data-i18n="dv.opt_print">Impression</div>
                <div class="prod-opt" data-val="other" data-i18n="dv.opt_other">Autre</div>
              </div>
              <input type="hidden" name="product" id="productVal" />
              <div class="form-error" id="err1" data-i18n="dv.required">Merci de compléter cette étape.</div>
              <div class="devis-actions">
                <button type="button" class="btn-royal" data-next="2"><span data-i18n="dv.next">Continuer</span><span class="ar"></span></button>
              </div>
            </div>

            <div class="devis-step" data-step="2">
              <h2 data-i18n="dv.s2">Les détails</h2>
              <div class="devis-form-grid">
                <div class="field">
                  <label><span data-i18n="dv.qty">Quantité estimée</span> <span class="req">*</span></label>
                  <input name="qty" type="text" inputmode="numeric" />
                </div>
                <div class="field">
                  <label data-i18n="dv.branding">Personnalisation souhaitée</label>
                  <textarea name="branding" data-i18n-ph="dv.branding_ph" placeholder="Logo, texte, couleurs, emplacement de la broderie…"></textarea>
                </div>
                <div class="field">
                  <label data-i18n="dv.deadline">Échéance souhaitée</label>
                  {/* type="date" so the visitor picks a calendar date instead of
                      typing free-text. min is set to today's date by the inline
                      script at the bottom of this file so past dates can't be
                      submitted. The native picker is locale-aware: French/Arabic
                      visitors see the date order they expect. */}
                  <input name="deadline" type="date" />
                </div>
              </div>
              <div class="form-error" id="err2" data-i18n="dv.required">Merci de compléter cette étape.</div>
              <div class="devis-actions">
                <button type="button" class="btn-ghost" data-prev="1"><span data-i18n="dv.back">Retour</span></button>
                <button type="button" class="btn-royal" data-next="3"><span data-i18n="dv.next">Continuer</span><span class="ar"></span></button>
              </div>
            </div>

            <div class="devis-step" data-step="3">
              <h2 data-i18n="dv.s3">Vos coordonnées</h2>
              <div class="devis-form-grid">
                <div class="field">
                  <label><span data-i18n="dv.name">Nom / Organisation</span> <span class="req">*</span></label>
                  <input name="name" type="text" autocomplete="organization" />
                </div>
                <div class="field">
                  <label><span data-i18n="dv.phone">Téléphone</span> <span class="req">*</span></label>
                  <input name="phone" type="tel" inputmode="tel" autocomplete="tel" />
                </div>
                <div class="field">
                  <label><span data-i18n="dv.email">Email</span> <span class="optional" data-i18n="ct.optional">(optionnel)</span></label>
                  {/* Email no longer required on the devis form either —
                      client asked for the same low-friction policy as
                      the contact form. Format check still runs if a
                      value is entered (see valid(3) below). */}
                  <input name="email" type="email" autocomplete="email" />
                </div>
              </div>
              <div class="field">
                <label data-i18n="dv.attach_label">Joindre des fichiers (logos, maquettes, charte graphique)</label>
                <div id="devisFilePicker"></div>
              </div>
              <div class="form-error" id="err3" data-i18n="dv.required">Merci de compléter cette étape.</div>
              <div class="devis-actions">
                <button type="button" class="btn-ghost" data-prev="2"><span data-i18n="dv.back">Retour</span></button>
                <button type="submit" class="btn-royal"><span data-i18n="dv.submit">Envoyer la demande</span><span class="ar"></span></button>
              </div>
            </div>
          </form>

          <div class="devis-sent" id="devisSent">
            <img class="seal" src="/assets/logo-crest-color.png" alt="" />
            <h2 data-i18n="dv.sent_h">Demande envoyée.</h2>
            <p data-i18n="dv.sent_p">Merci. Notre équipe étudie votre projet et vous recontacte avec une proposition sur-mesure.</p>
          </div>
        </div>

        <aside class="devis-aside">
          <h3 data-i18n="dv.why_h">Pourquoi un devis ?</h3>
          <ul class="why-list">
            <li><span class="wi">✓</span><span data-i18n="dv.why1">Grandes quantités à tarif dégressif</span></li>
            <li><span class="wi">✓</span><span data-i18n="dv.why2">Conception entièrement personnalisée</span></li>
            <li><span class="wi">✓</span><span data-i18n="dv.why3">Accompagnement & validation d’épreuve</span></li>
          </ul>
          <div class="cod-note" style="margin-top:24px;text-align:start;color:var(--fg-on-dark-2)">
            <a href="/boutique" style="color:var(--gold-bright)" data-i18n="pa.continue">Continuer mes achats</a>
          </div>
        </aside>
      </div>
    </div>

    <!-- ===== MODE · MESSAGE ===== -->
    <div class="cmode" data-mode="message">
      <div class="contact-grid">

      <div class="contact-card">
        <h2 data-i18n="ct.form_h">Envoyez-nous un message</h2>
        <form class="contact-form" id="contactForm" novalidate>
          <div class="field">
            <label><span data-i18n="ct.name">Nom complet</span> <span class="req">*</span></label>
            <input name="cName" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label><span data-i18n="ct.phone">Téléphone</span> <span class="req">*</span></label>
            <input name="cPhone" type="tel" inputmode="tel" autocomplete="tel" required />
          </div>
          <div class="field">
            <label><span data-i18n="ct.email">Email</span> <span class="optional" data-i18n="ct.optional">(optionnel)</span></label>
            {/* email no longer required — client wants to lower the friction
                on the contact form. Validation still runs if a value is
                entered (see EMAIL_RE in the submit handler). */}
            <input name="cEmail" type="email" autocomplete="email" />
          </div>
          <div class="field">
            <label><span data-i18n="ct.message">Votre message</span> <span class="req">*</span></label>
            <textarea name="cMessage" required></textarea>
          </div>
          <div class="field">
            <label data-i18n="ct.attach_label">Joindre des fichiers (optionnel)</label>
            <div id="contactFilePicker"></div>
          </div>
          <div class="form-error" id="cError" data-i18n="ct.required">Merci de remplir les champs requis.</div>
          <button type="submit" class="btn-royal full" style="justify-content:center"><span data-i18n="ct.send">Envoyer le message</span><span class="ar"></span></button>
        </form>
        <div class="contact-sent" id="contactSent">
          <img class="seal" src="/assets/logo-crest-color.png" alt="" />
          <h3 data-i18n="ct.sent_h">Message envoyé.</h3>
          <p data-i18n="ct.sent_p">Merci de nous avoir écrit. Notre équipe vous répondra très prochainement.</p>
        </div>
      </div>

      <div class="info-col">
        <div class="info-block">
          <div class="ib-eyebrow" data-i18n="ct.alger">Showroom Alger</div>
          <h3 data-i18n="ct.alger">Showroom Alger</h3>
          <div class="addr">Lotissement Soufflerie n°12, Dar El-Beïda<br>16100, Alger</div>
          <div class="ph-label" data-i18n="ct.phones">Téléphones</div>
          <ul class="ph-list"><li><a href="tel:+21323823081">+213.23.82.30.81</a></li><li><a href="tel:+21323823089">+213.23.82.30.89</a></li><li><a href="tel:+21327804040">+213.27.80.40.40</a></li><li><a href="tel:+213560939944">+213.560.939.944</a></li><li><a href="tel:+21323823087">+213.23.82.30.87</a></li><li><a href="tel:+21327804445">+213.27.80.44.45</a></li></ul>
          <div class="contact-line">
            <span class="ci"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg></span>
            <a href="mailto:info@broderieroyale.com">info@broderieroyale.com</a>
          </div>
          <div class="msg-highlight">
            <div class="mh-k" data-i18n="ct.messaging">Mobile · Viber · WeChat · WhatsApp</div>
            <a href="https://wa.me/213560998877">+213 560 99 88 77</a>
          </div>
        </div>

        <div class="info-block">
          <div class="ib-eyebrow" data-i18n="ct.djelfa">Showroom Djelfa</div>
          <h3 data-i18n="ct.djelfa">Showroom Djelfa</h3>
          <div class="addr">RN n°1, BP 273, Aïn Ouessara<br>17200, Djelfa</div>
          <div class="ph-label" data-i18n="ct.phones">Téléphones</div>
          <ul class="ph-list"><li><a href="tel:+21327822096">+213.27.82.20.96</a></li><li><a href="tel:+21327826464">+213.27.82.64.64</a></li></ul>
        </div>

        <div class="info-block">
          <div class="ib-eyebrow" data-i18n="ct.boumerdes">Showroom Boumerdès</div>
          <h3 data-i18n="ct.boumerdes">Showroom Boumerdès</h3>
          <div class="addr">[Adresse à compléter]<br>35000, Boumerdès</div>
          <div class="ph-label" data-i18n="ct.phones">Téléphones</div>
          <ul class="ph-list"><li><a href="tel:+213000000000">+213 — à compléter</a></li></ul>
        </div>

        <div class="info-block">
          <div class="ib-eyebrow" data-i18n="ct.services">Services dédiés</div>
          <div class="services-grid">
            <div class="svc-cell">
              <div class="sc-name" data-i18n="ct.svc_print">Service print & drapeaux</div>
              <a href="tel:+213660203044">+213.660.203.044</a>
              <a href="tel:+213660203648">+213.660.203.648</a>
            </div>
            <div class="svc-cell">
              <div class="sc-name" data-i18n="ct.svc_brod">Service broderie</div>
              <a href="tel:+213660203638">+213.660.203.638</a>
            </div>
            <div class="svc-cell">
              <div class="sc-name" data-i18n="ct.svc_bill">Service facturation</div>
              <a href="tel:+213660203658">+213.660.203.658</a>
            </div>
          </div>
        </div>
      </div>

      </div>
    </div>
  </div>

  <section class="map-section">
    <div class="map-sticky">
    <div class="map-head">
      <div class="eyebrow" data-i18n="ct.map_eyebrow">TROIS MAISONS</div>
      <h2 data-i18n="ct.map_title">Alger, Boumerdès & Aïn Ouessara.</h2>
      <p class="map-sub" data-i18n="ct.map_sub">Trois ateliers, une même exigence — au cœur de l’Algérie.</p>
    </div>
    {/* Two-column stage: city labels on the left, the SVG map on the
        right. .map-stage is a flex container that centers the pair as
        a group; the labels keep their own width and the map fills the
        rest up to its max-width. Avoids the previous absolute-overlay
        positioning that was clipping the leftmost edge of the Algeria
        outline. */}
    <div class="map-stage">
      <div class="map-labels" id="mapLabels" aria-hidden="true">
        {/* Order mirrors the map-title sentence and the pins array
            below: Alger -> Boumerdès -> Aïn Ouessara. */}
        <div class="map-label" data-pin="1">
          <span class="map-label-num">01</span>
          <span class="map-label-name">Alger</span>
        </div>
        <div class="map-label" data-pin="3">
          <span class="map-label-num">02</span>
          <span class="map-label-name">Boumerdès</span>
        </div>
        <div class="map-label" data-pin="2">
          <span class="map-label-num">03</span>
          <span class="map-label-name">Aïn Ouessara</span>
        </div>
      </div>
      <div class="map-wrap">
      <svg class="alg-map" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 997" preserveAspectRatio="xMidYMin meet" role="img" aria-label="Carte de l'Algérie — Alger, Boumerdès et Aïn Ouessara">
      <defs><radialGradient id="mhalo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#A98847" stop-opacity="0.22"/><stop offset="100%" stop-color="#A98847" stop-opacity="0"/>
      </radialGradient><linearGradient id="vanishGrad" gradientUnits="userSpaceOnUse" x1="0" y1="225" x2="0" y2="360"><stop offset="0" stop-color="#1A1A1A" stop-opacity="0"/><stop offset="1" stop-color="#1A1A1A" stop-opacity="1"/></linearGradient><linearGradient id="pinGold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E0C079"/><stop offset="0.45" stop-color="#A98847"/><stop offset="1" stop-color="#7C6230"/></linearGradient></defs>
