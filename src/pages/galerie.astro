---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Galerie — Broderie Royale Algérie"
  ogTitle="Galerie — Broderie Royale Algérie"
  bodyClass="shop"
  dataPage="galerie"
>
<header class="shop-hero">
  <div class="inner">
    <div class="eyebrow" data-i18n="ga.eyebrow">RÉALISATIONS · MAISON DU DRAPEAU</div>
    <h1 data-i18n="ga.title">La Galerie.</h1>
    <p data-i18n="ga.sub">Une sélection de commandes officielles, d’écussons brodés et de drapeaux d’exception, signés de notre fil d’or.</p>
  </div>
</header>
<main>
  <div class="gal-body">
    <div class="gal-filters" id="galFilters">
      <button class="filter-chip active" data-f="all" data-i18n="ga.all">Tout</button>
      <button class="filter-chip" data-f="flags" data-i18n="ga.f_flags">Drapeaux</button>
      <button class="filter-chip" data-f="crest" data-i18n="ga.f_crest">Écussons</button>
      <button class="filter-chip" data-f="event" data-i18n="ga.f_event">Événements</button>
      <button class="filter-chip" data-f="brod" data-i18n="ga.f_brod">Broderie</button>
    </div>
    {/* ============================================================
        GALLERY LAYOUT — dynamic, CMS-driven.

        Photos live in Odoo: Website CMS ▸ Content ▸ Gallery. Each
        entry has an image, translatable caption, orientation
        (portrait / landscape) and category. The list is fetched at
        page load via /api/v1/website/gallery and rendered here.

        The 3-column grid keeps the portrait / landscape / portrait
        rhythm — admin should upload matching mixes for cleanest
        result, but any orientation combination will still render
        (each tile takes its own aspect based on the orientation
        field). Below 900px collapses to a single column.
        ============================================================ */}
    <div class="gal-grid" id="galGrid" aria-live="polite">
      <div class="br-loading" data-i18n="ga.loading">Chargement de la galerie…</div>
    </div>

    <section class="gal-cta">
      <h2 data-i18n="ga.cta_h">Un projet sur-mesure ?</h2>
      <p data-i18n="ga.cta_p">Confiez-nous votre identité textile. Demandez un devis personnalisé.</p>
      <a class="btn-royal" href="/contact#devis"><span data-i18n="ct.tab_devis">Demander un devis</span><span class="ar"></span></a>
    </section>
  </div>
</main>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lb-close" id="lbClose" aria-label="Fermer">×</button>
  <button class="lb-nav lb-prev" id="lbPrev" aria-label="Précédent">‹</button>
  <button class="lb-nav lb-next" id="lbNext" aria-label="Suivant">›</button>
  <figure><img id="lbImg" src="" alt="" /><figcaption id="lbCap"></figcaption></figure>
</div>

<script is:inline data-astro-rerun>
(async function(){
  var grid = document.getElementById('galGrid');
  if (!grid) return;
  // Wait for BR_API to be ready (bottom-of-body script). On SPA nav
  // via ClientRouter it's already there.
  if (document.readyState === 'loading') {
    await new Promise(function(r){ document.addEventListener('DOMContentLoaded', r, { once: true }); });
  }
  if (!window.BR_API) return;

  function esc(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, function(c){
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }

  function tileFor(item) {
    var orient = item.orientation === 'portrait' ? 'gal-portrait' : 'gal-landscape';
    var cap = item.caption || '';
    return '<figure class="gal-item ' + orient + '" data-cat="' + esc(item.category) +
           '" data-img="' + esc(item.image_url) + '">' +
             '<img src="' + esc(item.image_url) + '" alt="' + esc(cap) + '" loading="lazy" />' +
             '<figcaption class="gal-cap">' +
               '<span class="gc-k">Broderie Royale</span>' +
               '<span class="gc-t">' + esc(cap) + '</span>' +
             '</figcaption>' +
           '</figure>';
  }

  var items = [];
  try {
    var res = await window.BR_API.getGallery();
    items = (res && res.gallery) || [];
  } catch (err) {
    console.error('[BR] gallery fetch failed', err);
    grid.innerHTML = '';
    return;
  }
  if (!items.length) {
    grid.innerHTML = '';
    return;
  }
  grid.innerHTML = items.map(tileFor).join('');

  // Filter chips
  var itemEls = Array.prototype.slice.call(grid.querySelectorAll('.gal-item'));
  var filters = document.getElementById('galFilters');
  if (filters && !filters.dataset.bound) {
    filters.dataset.bound = '1';
    filters.addEventListener('click', function(e){
      var b = e.target.closest('.filter-chip'); if (!b) return;
      filters.querySelectorAll('.filter-chip').forEach(function(x){ x.classList.remove('active'); });
      b.classList.add('active');
      var f = b.dataset.f;
      itemEls.forEach(function(it){ it.style.display = (f === 'all' || it.dataset.cat === f) ? '' : 'none'; });
    });
  }

  // Staggered scroll-in reveal. The global effects.js gallery IO runs
  // at page load, before this fetch resolves — so we wire a fresh IO
  // here for the newly-inserted tiles (same 80ms stagger).
  var galIO = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      var idx = itemEls.indexOf(e.target);
      e.target.style.transitionDelay = Math.max(0, idx) * 80 + 'ms';
      e.target.classList.add('gal-in');
      galIO.unobserve(e.target);
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
  itemEls.forEach(function(el){ galIO.observe(el); });

  // Lightbox
  var lb = document.getElementById('lightbox'),
      lbImg = document.getElementById('lbImg'),
      lbCap = document.getElementById('lbCap');
  var cur = 0;
  function visible(){ return itemEls.filter(function(it){ return it.style.display !== 'none' && it.dataset.img; }); }
  function show(i){
    var v = visible(); if (!v.length) return;
    cur = (i + v.length) % v.length;
    var it = v[cur];
    lbImg.src = it.dataset.img;
    var cap = it.querySelector('.gc-t');
    lbCap.innerHTML = '<b>Broderie Royale</b> — ' + (cap ? cap.textContent : '');
  }
  grid.addEventListener('click', function(e){
    var it = e.target.closest('.gal-item'); if (!it) return;
    if (!it.dataset.img) return;
    var v = visible(); cur = v.indexOf(it); show(cur);
    lb.classList.add('open'); lb.setAttribute('aria-hidden', 'false');
  });
  if (lb && !lb.dataset.bound) {
    lb.dataset.bound = '1';
    document.getElementById('lbClose').addEventListener('click', function(){ lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true'); });
    document.getElementById('lbNext').addEventListener('click', function(){ show(cur + 1); });
    document.getElementById('lbPrev').addEventListener('click', function(){ show(cur - 1); });
    lb.addEventListener('click', function(e){ if (e.target === lb) { lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true'); } });
    document.addEventListener('keydown', function(e){
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') { lb.classList.remove('open'); }
      if (e.key === 'ArrowRight') { show(cur + 1); }
      if (e.key === 'ArrowLeft') { show(cur - 1); }
    });
  }
})();
</script>
</BaseLayout>
