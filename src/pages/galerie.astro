---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Galerie — Broderie Royale Algérie"
  ogTitle="Galerie — Broderie Royale Algérie"
  bodyClass="shop"
  dataPage="galerie"
>
<header class="shop-hero">
  <div class="inner">
    <div class="eyebrow" data-i18n="ga.eyebrow">RÉALISATIONS · MAISON DU DRAPEAU</div>
    <h1 data-i18n="ga.title">La Galerie.</h1>
    <p data-i18n="ga.sub">Une sélection de commandes officielles, d’écussons brodés et de drapeaux d’exception, signés de notre fil d’or.</p>
  </div>
</header>
<main>
  <div class="gal-body">
    <div class="gal-filters" id="galFilters">
      <button class="filter-chip active" data-f="all" data-i18n="ga.all">Tout</button>
      <button class="filter-chip" data-f="flags" data-i18n="ga.f_flags">Drapeaux</button>
      <button class="filter-chip" data-f="crest" data-i18n="ga.f_crest">Écussons</button>
      <button class="filter-chip" data-f="event" data-i18n="ga.f_event">Événements</button>
      <button class="filter-chip" data-f="brod" data-i18n="ga.f_brod">Broderie</button>
    </div>
    {/* ============================================================
        GALLERY LAYOUT — one repeating row pattern (4 images):

          Column 1        Column 2          Column 3
          ┌────────┐      ┌──────────┐      ┌────────┐
          │        │      │ landscape│      │        │
          │        │      │   4 : 3  │      │        │
          │portrait│      ├──────────┤      │portrait│
          │  2 : 3 │      │ landscape│      │  2 : 3 │
          │        │      │   4 : 3  │      │        │
          └────────┘      └──────────┘      └────────┘

        Portrait aspect ratio:  2 wide × 3 tall  (e.g. 800×1200 px)
        Landscape aspect ratio: 4 wide × 3 tall  (e.g. 1200×900 px)

        Client uploads images in this fixed order per row —
        [portrait, landscape, landscape, portrait] — and the
        grid places them automatically. Keep the pattern in
        multiples of 4 for clean rows.
        ============================================================ */}
    <div class="gal-grid" id="galGrid">
      {/* Row 1 */}
      <figure class="gal-item gal-portrait" data-cat="flags" data-img="/assets/photo-flag-international.webp" data-capkey="g1">
        <img src="/assets/photo-flag-international.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g1"></span></figcaption>
      </figure>
      <figure class="gal-item gal-landscape" data-cat="crest" data-img="/assets/texture-embroidery-patch.webp" data-capkey="g2">
        <img src="/assets/texture-embroidery-patch.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g2"></span></figcaption>
      </figure>
      <figure class="gal-item gal-landscape" data-cat="event" data-img="/assets/photo-flags-row.webp" data-capkey="g3">
        <img src="/assets/photo-flags-row.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g3"></span></figcaption>
      </figure>
      <figure class="gal-item gal-portrait" data-cat="crest" data-img="/assets/photo-pennant.webp" data-capkey="g4">
        <img src="/assets/photo-pennant.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g4"></span></figcaption>
      </figure>
      {/* Row 2 */}
      <figure class="gal-item gal-portrait" data-cat="event" data-img="/assets/photo-desk-flags-br.webp" data-capkey="g7">
        <img src="/assets/photo-desk-flags-br.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g7"></span></figcaption>
      </figure>
      <figure class="gal-item gal-landscape" data-cat="brod" data-img="/assets/metier-broderie.webp" data-capkey="g5">
        <img src="/assets/metier-broderie.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g5"></span></figcaption>
      </figure>
      <figure class="gal-item gal-landscape" data-cat="flags" data-img="/assets/photo-flag-lobby.webp" data-capkey="g6">
        <img src="/assets/photo-flag-lobby.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g6"></span></figcaption>
      </figure>
      <figure class="gal-item gal-portrait" data-cat="flags" data-img="/assets/metier-polyester.webp" data-capkey="g9">
        <img src="/assets/metier-polyester.webp" alt="" loading="lazy" />
        <figcaption class="gal-cap"><span class="gc-k">Broderie Royale</span><span class="gc-t" data-i18n="ga.g9"></span></figcaption>
      </figure>
    </div>

    <section class="gal-cta">
      <h2 data-i18n="ga.cta_h">Un projet sur-mesure ?</h2>
      <p data-i18n="ga.cta_p">Confiez-nous votre identité textile. Demandez un devis personnalisé.</p>
      <a class="btn-royal" href="/contact#devis"><span data-i18n="ct.tab_devis">Demander un devis</span><span class="ar"></span></a>
    </section>
  </div>
</main>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lb-close" id="lbClose" aria-label="Fermer">×</button>
  <button class="lb-nav lb-prev" id="lbPrev" aria-label="Précédent">‹</button>
  <button class="lb-nav lb-next" id="lbNext" aria-label="Suivant">›</button>
  <figure><img id="lbImg" src="" alt="" /><figcaption id="lbCap"></figcaption></figure>
</div>

<script is:inline>
(function(){
  var grid=document.getElementById('galGrid');
  var items=Array.prototype.slice.call(grid.querySelectorAll('.gal-item'));
  document.getElementById('galFilters').addEventListener('click',function(e){
    var b=e.target.closest('.filter-chip'); if(!b) return;
    document.querySelectorAll('#galFilters .filter-chip').forEach(function(x){x.classList.remove('active');});
    b.classList.add('active');
    var f=b.dataset.f;
    items.forEach(function(it){ it.style.display=(f==='all'||it.dataset.cat===f)?'':'none'; });
  });
  var lb=document.getElementById('lightbox'), lbImg=document.getElementById('lbImg'), lbCap=document.getElementById('lbCap');
  var cur=0;
  function visible(){ return items.filter(function(it){return it.style.display!=='none';}); }
  function show(i){ var v=visible(); if(!v.length) return; cur=(i+v.length)%v.length; var it=v[cur];
    lbImg.src=it.dataset.img; var cap=it.querySelector('.gc-t'); lbCap.innerHTML='<b>Broderie Royale</b> — '+(cap?cap.textContent:''); }
  grid.addEventListener('click',function(e){ var it=e.target.closest('.gal-item'); if(!it) return;
    var v=visible(); cur=v.indexOf(it); show(cur); lb.classList.add('open'); lb.setAttribute('aria-hidden','false'); });
  document.getElementById('lbClose').addEventListener('click',function(){ lb.classList.remove('open'); lb.setAttribute('aria-hidden','true'); });
  document.getElementById('lbNext').addEventListener('click',function(){ show(cur+1); });
  document.getElementById('lbPrev').addEventListener('click',function(){ show(cur-1); });
  lb.addEventListener('click',function(e){ if(e.target===lb) { lb.classList.remove('open'); lb.setAttribute('aria-hidden','true'); } });
  document.addEventListener('keydown',function(e){ if(!lb.classList.contains('open'))return;
    if(e.key==='Escape'){lb.classList.remove('open');} if(e.key==='ArrowRight'){show(cur+1);} if(e.key==='ArrowLeft'){show(cur-1);} });
})();
</script>
</BaseLayout>
