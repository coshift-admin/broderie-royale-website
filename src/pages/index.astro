---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Broderie Royale Algérie — Maison du Drapeau"
  showOverture={true}
  storyEffects={true}
  isHero={true}
  emitLocalBusiness={true}
>
<main>

  <!-- ============== HERO ============== -->
  <section id="hero" data-thread-node>
    <div class="hero-bg">
      <video id="heroBg" autoplay muted loop playsinline poster="/assets/texture-embroidery-patch.webp">
        <source src="/assets/hero-loop.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-inner">
      <div class="hero-crest-wrap">
        <img class="hero-crest" id="heroCrestBase" src="/assets/hero-crest-base.png" alt="Broderie Royale Algérie" fetchpriority="high" />
        <img class="hero-crown" id="heroCrown" src="/assets/hero-crown.png" alt="" />
      </div>
      {/* Brand wordmark sits between the crest and the "MAISON DU DRAPEAU"
          eyebrow — same light variant the nav uses, so the lockup reads
          as a single piece in the hero. */}
      <img class="hero-wordmark" src="/assets/nav-wordmark-light.png" alt="Broderie Royale Algérie — Maison du Drapeau · depuis 1986" />
      <h1 class="hero-title" data-i18n="hero.title" data-i18n-html>La perfection <em>c’est notre métier.</em></h1>
      <p class="hero-sub" data-i18n="hero.sub">Communication visuelle par le textile de haute qualité. Drapeaux, écussons et broderie d’exception — signés en Algérie depuis près de quarante ans.</p>
    </div>
    <div class="scroll-hint">
      <span data-i18n="hero.scroll">Suivez le fil</span>
      <div class="dot"></div>
    </div>
  </section>

  <!-- ============== I · HERITAGE ============== -->
  <section id="heritage" class="chapter chapter--ivory" data-thread-node>
    <div class="wrap heritage-grid">
      <div>
        <span class="chap-num reveal" data-i18n="her.num">I — L’Institution</span>
        <hr class="gold-rule reveal d1" />
        <h2 class="chap-title reveal d1" data-i18n="her.title">Une référence textile institutionnelle.</h2>
        <p class="lead reveal d2 measure" data-i18n="her.body">Depuis 1986, Broderie Royale Algérie développe un savoir-faire familial spécialisé dans la fabrication de drapeaux officiels, d’écussons brodés, d’étendards et de produits textiles personnalisés, afin d’offrir aux institutions, organismes et marques une présence visuelle élégante et fiable.</p>
        {/* Value chips: hover (desktop) or tap (mobile) reveals the client-
            approved short description. Chip stays compact; tooltip appears
            above with a smooth gold-thread swell — matching the brand's
            "detail reveals itself" tone. */}
        <div class="values-row reveal d3">
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v1">Expérience</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v1d">Un parcours familial depuis 1986 dans les drapeaux et les produits textiles officiels.</span>
          </span>
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v2">Qualité</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v2d">Des matières sélectionnées, des couleurs stables et une finalisation adaptée aux usages officiels.</span>
          </span>
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v3">Professionnalisme</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v3d">Une organisation claire des commandes, un suivi rigoureux et le respect des exigences de chaque institution.</span>
          </span>
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v4">Maîtrise</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v4d">Une attention précise à chaque détail, du design au dernier point de broderie.</span>
          </span>
        </div>
      </div>
      <div class="stat-stack reveal d2">
        <div class="stat">
          <div class="stat-num" data-i18n="her.s1n">40+ ans</div>
          <div class="stat-lab" data-i18n="her.s1l">D’expérience</div>
        </div>
        <div class="stat">
          <div class="stat-num" data-i18n="her.s2n">360 000+</div>
          <div class="stat-lab" data-i18n="her.s2l">Drapeaux réalisés</div>
        </div>
        <div class="stat">
          <div class="stat-num" data-i18n="her.s3n">1 million+</div>
          <div class="stat-lab" data-i18n="her.s3l">De pièces brodées</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== II · ATELIER ============== -->
  <section id="atelier" class="chapter chapter--ink atelier" data-thread-node>
    <div class="wrap atelier-grid">
      <div>
        <span class="chap-num reveal" data-i18n="at.num">II — Le Savoir-faire</span>
        <hr class="gold-rule reveal d1" />
        <h2 class="chap-title reveal d1" data-i18n="at.title">Des détails réalisés avec précision.</h2>
        <p class="lead reveal d2" data-i18n="at.body">Du choix du tissu et du fil à la broderie et à la finalisation, chaque pièce passe par des étapes de soin minutieux qui préservent sa forme et sa valeur. Chez Broderie Royale Algérie, le savoir-faire est un standard de qualité qui accompagne chaque produit afin de refléter l’identité de l’institution avec clarté et stabilité.</p>
      </div>
      <div class="atelier-media reveal d1" data-parallax="0.12">
        <img src="/assets/photo-embroidery-machine.webp" alt="Broderie machine" width="1121" height="421" loading="lazy" decoding="async" />
        <div class="media-caption" data-i18n="at.cap">Broderie machine multi-têtes — Atelier d’Alger</div>
      </div>
    </div>
  </section>

  <!-- ============== III · METIERS (category-swap showcase) ==============
       Replaces the earlier sticky-stack pattern (5× 100vh pinned scroll)
       with a single-viewport carousel: one category at a time, two
       balanced panes (image + text/CTA), 01/05 progress, prev/next +
       dot nav. Auto-advances every 7s when in view, pauses on hover /
       focus. Mobile collapses to a vertical stack — every card visible
       at once, no swipe required. -->
  <section id="metiers" class="chapter chapter--ink" data-thread-node>
    <div class="metiers-header wrap">
      <span class="chap-num reveal" data-i18n="me.num">III — Domaines d’expertise</span>
      <hr class="gold-rule reveal d1" />
      <h2 class="chap-title reveal d1" data-i18n="me.title" data-i18n-html>Un même standard,<br>plusieurs expertises.</h2>
      <p class="lead measure reveal d2" data-i18n="me.sub">Des drapeaux aux écussons, étendards et produits personnalisés, nous appliquons le même standard : qualité d’exécution, précision des détails et présence adaptée aux institutions.</p>
    </div>

    <div class="metiers-showcase reveal d3" id="metiersShowcase">
      <div class="ms-viewport">
        <button class="ms-nav ms-prev" type="button" aria-label="Précédent">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="ms-nav ms-next" type="button" aria-label="Suivant">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
        <div class="ms-track" id="metierTrack">
          <article class="ms-slide is-active" data-idx="0">
            <div class="ms-image"><img src="/assets/photo-flag-international.webp" alt="" width="1144" height="767" loading="lazy" decoding="async" /></div>
            <div class="ms-body">
              <span class="ms-idx">01</span>
              <h3 class="ms-name" data-i18n="me.1n">Drapeaux</h3>
              <p class="ms-desc" data-i18n="me.1d">Drapeaux nationaux et internationaux, de bureau et d’extérieur, réalisés avec des matières résistantes.</p>
              <a class="btn-royal ms-cta" href="/boutique"><span data-i18n="me.cta">Voir le catalogue</span><span class="ar"></span></a>
            </div>
          </article>
          <article class="ms-slide" data-idx="1">
            <div class="ms-image"><img src="/assets/texture-embroidery-patch.webp" alt="" width="960" height="540" loading="lazy" decoding="async" /></div>
            <div class="ms-body">
              <span class="ms-idx">02</span>
              <h3 class="ms-name" data-i18n="me.2n">Écussons</h3>
              <p class="ms-desc" data-i18n="me.2d">Écussons et insignes brodés pour organismes, clubs et institutions.</p>
              <a class="btn-royal ms-cta" href="/boutique"><span data-i18n="me.cta">Voir le catalogue</span><span class="ar"></span></a>
            </div>
          </article>
          <article class="ms-slide" data-idx="2">
            <div class="ms-image"><img src="/assets/photo-pennant.webp" alt="" width="1071" height="827" loading="lazy" decoding="async" /></div>
            <div class="ms-body">
              <span class="ms-idx">03</span>
              <h3 class="ms-name" data-i18n="me.3n">Étendards</h3>
              <p class="ms-desc" data-i18n="me.3d">Étendards officiels et cérémoniels, avec une finalisation soignée et une présence distinctive.</p>
              <a class="btn-royal ms-cta" href="/boutique"><span data-i18n="me.cta">Voir le catalogue</span><span class="ar"></span></a>
            </div>
          </article>
          <article class="ms-slide" data-idx="3">
            <div class="ms-image"><img src="/assets/metier-broderie.webp" alt="" width="720" height="894" loading="lazy" decoding="async" /></div>
            <div class="ms-body">
              <span class="ms-idx">04</span>
              <h3 class="ms-name" data-i18n="me.4n">Broderie</h3>
              <p class="ms-desc" data-i18n="me.4d">Broderie personnalisée sur vêtements, casquettes et tenues professionnelles.</p>
              <a class="btn-royal ms-cta" href="/boutique"><span data-i18n="me.cta">Voir le catalogue</span><span class="ar"></span></a>
            </div>
          </article>
          <article class="ms-slide" data-idx="4">
            <div class="ms-image"><img src="/assets/metier-polyester.webp" alt="" width="1200" height="896" loading="lazy" decoding="async" /></div>
            <div class="ms-body">
              <span class="ms-idx">05</span>
              <h3 class="ms-name" data-i18n="me.5n">Impression textile</h3>
              <p class="ms-desc" data-i18n="me.5d">Impression numérique nette et durable sur tissu.</p>
              <a class="btn-royal ms-cta" href="/boutique"><span data-i18n="me.cta">Voir le catalogue</span><span class="ar"></span></a>
            </div>
          </article>
        </div>
      </div>
      <div class="ms-controls">
        <div class="ms-progress"><span class="ms-cur">01</span><span class="ms-sep">/</span><span class="ms-tot">05</span></div>
        <div class="ms-dots" role="tablist">
          <button class="md is-active" type="button" data-idx="0" aria-label="Domaine 1"></button>
          <button class="md" type="button" data-idx="1" aria-label="Domaine 2"></button>
          <button class="md" type="button" data-idx="2" aria-label="Domaine 3"></button>
          <button class="md" type="button" data-idx="3" aria-label="Domaine 4"></button>
          <button class="md" type="button" data-idx="4" aria-label="Domaine 5"></button>
        </div>
      </div>
    </div>

    <script is:inline data-astro-rerun>
      (function(){
        var root = document.getElementById('metiersShowcase');
        if (!root || root.dataset.bound) return;
        root.dataset.bound = '1';
        var track = root.querySelector('.ms-track');
        var slides = Array.prototype.slice.call(track.querySelectorAll('.ms-slide'));
        var dots = Array.prototype.slice.call(root.querySelectorAll('.ms-dots .md'));
        var prev = root.querySelector('.ms-prev');
        var next = root.querySelector('.ms-next');
        var curEl = root.querySelector('.ms-cur');
        var totEl = root.querySelector('.ms-tot');
        var n = slides.length;
        var idx = 0;
        var timer = null;
        var inView = false;
        var paused = false;
        totEl.textContent = ('0' + n).slice(-2);
        function pad(v){ return ('0' + v).slice(-2); }
        function go(i, userDriven){
          idx = ((i % n) + n) % n;
          slides.forEach(function(s, k){ s.classList.toggle('is-active', k === idx); });
          dots.forEach(function(d, k){ d.classList.toggle('is-active', k === idx); });
          curEl.textContent = pad(idx + 1);
          if (userDriven) restart();
        }
        function tick(){
          if (paused || !inView) return;
          go(idx + 1);
        }
        function restart(){
          if (timer) clearInterval(timer);
          timer = setInterval(tick, 7000);
        }
        prev.addEventListener('click', function(){ go(idx - 1, true); });
        next.addEventListener('click', function(){ go(idx + 1, true); });
        dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k, true); }); });
        root.addEventListener('mouseenter', function(){ paused = true; });
        root.addEventListener('mouseleave', function(){ paused = false; });
        root.addEventListener('focusin', function(){ paused = true; });
        root.addEventListener('focusout', function(){ paused = false; });
        // Only auto-advance when the showcase is actually in view
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){ inView = e.isIntersecting; });
        }, { threshold: 0.35 });
        io.observe(root);
        // Keyboard nav when a dot is focused
        root.addEventListener('keydown', function(e){
          if (e.key === 'ArrowRight') { go(idx + 1, true); }
          else if (e.key === 'ArrowLeft') { go(idx - 1, true); }
        });
        restart();
      })();
    </script>
  </section>

  <!-- ============== IV · SERVE ==============
       Audience qualifier: tells the visitor "this is for you" right after
       the products. Originally sat after Prestige/Partners (between two
       trust signals); moved up so it splits product showcase from social
       proof instead of fragmenting the social proof itself. -->
  <section id="serve" class="chapter chapter--ivory" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="sv.num">IV — Au Service de</span>
      <hr class="gold-rule reveal d1" />
      <h2 class="chap-title reveal d1" data-i18n="sv.title">Des entités qui représentent leur identité avec confiance.</h2>
      <div class="serve-grid">
        <div class="serve-cell reveal"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M18 44 L50 26 L82 44"/><path pathLength="1" d="M22 44 L78 44"/><path pathLength="1" d="M28 46 L28 74"/><path pathLength="1" d="M42 46 L42 74"/><path pathLength="1" d="M58 46 L58 74"/><path pathLength="1" d="M72 46 L72 74"/><path pathLength="1" d="M20 74 L80 74"/><path pathLength="1" d="M14 80 L86 80"/><path pathLength="1" d="M50 9 L51.41 13.06 L55.71 13.15 L52.28 15.74 L53.53 19.85 L50 17.4 L46.47 19.85 L47.72 15.74 L44.29 13.15 L48.59 13.06 Z"/></svg><span class="sn">01</span><span class="serve-rule"></span><span class="st" data-i18n="sv.1">Organismes officiels et institutions de l’État</span></div>
        <div class="serve-cell reveal d1"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M16 80 L84 80"/><path pathLength="1" d="M22 80 L22 56 L38 56 L38 80"/><path pathLength="1" d="M42 80 L42 40 L60 40 L60 80"/><path pathLength="1" d="M62 80 L62 60 L78 60 L78 80"/><path pathLength="1" d="M51 40 L51 30"/><path pathLength="1" d="M51 31 L61 33.5 L51 36"/></svg><span class="sn">02</span><span class="serve-rule"></span><span class="st" data-i18n="sv.2">Collectivités locales</span></div>
        <div class="serve-cell reveal d2"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M50 16 L76 26 L76 50 C76 66 64 76 50 82 C36 76 24 66 24 50 L24 26 Z"/><path pathLength="1" d="M38 48 L47 57 L64 38"/></svg><span class="sn">03</span><span class="serve-rule"></span><span class="st" data-i18n="sv.3">Sociétés de sécurité et de gardiennage</span></div>
        <div class="serve-cell reveal"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M28 62 A22 22 0 0 1 72 62"/><circle pathLength="1" cx="50" cy="34" r="2.6"/><path pathLength="1" d="M50 36.6 L50 40"/><path pathLength="1" d="M22 66 L78 66"/><path pathLength="1" d="M32 70 Q50 75 68 70"/></svg><span class="sn">04</span><span class="serve-rule"></span><span class="st" data-i18n="sv.4">Hôtels et restaurants</span></div>
        <div class="serve-cell reveal d1"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M38 34 L62 34 L60 50 C60 58 55 62 50 62 C45 62 40 58 40 50 Z"/><path pathLength="1" d="M38 36 C30 36 30 50 41 50"/><path pathLength="1" d="M62 36 C70 36 70 50 59 50"/><path pathLength="1" d="M50 62 L50 70"/><path pathLength="1" d="M40 70 L60 70"/><path pathLength="1" d="M36 76 L64 76"/></svg><span class="sn">05</span><span class="serve-rule"></span><span class="st" data-i18n="sv.5">Clubs sportifs</span></div>
        <div class="serve-cell reveal d2"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M40 28 L26 40 L34 48 L34 76 L66 76 L66 48 L74 40 L60 28"/><path pathLength="1" d="M40 28 L50 38 L60 28"/><path pathLength="1" d="M50 38 L50 54"/></svg><span class="sn">06</span><span class="serve-rule"></span><span class="st" data-i18n="sv.6">Particuliers et demandes spécifiques</span></div>
      </div>
    </div>
  </section>

  <!-- ============== V · FLAG ============== -->
  <section id="flag" data-thread-node>
    <div class="flag-media" data-parallax-bg>
      {/* Landscape lobby shot cropped to a 2:3 portrait for phones so the
          flag stays the main subject on tall viewports — the wide source
          otherwise gets sides-cropped and the flag drifts off-screen. */}
      <picture>
        <source media="(max-width: 720px)" srcset="/assets/photo-flag-lobby-p.webp" width="684" height="1024" />
        <img src="/assets/photo-flag-lobby.webp" alt="Drapeau algérien dans un hall de marbre" width="1536" height="1024" loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="flag-scrim"></div>
    <div class="flag-content">
      <div class="flag-inner">
        <span class="chap-num reveal" data-i18n="fl.num">V — Le Drapeau</span>
        <hr class="gold-rule reveal d1" />
        <h2 class="flag-quote reveal d1" data-i18n="fl.quote" data-i18n-html>Des salles d’honneur aux tribunes officielles, nos drapeaux <em>se hissent avec stabilité et présence.</em></h2>
        <p class="lead reveal d2 mt-m" data-i18n="fl.body">Nous concevons et fabriquons des drapeaux institutionnels, cérémoniels et publicitaires, avec des matières résistantes et une exécution précise adaptée aux événements et aux espaces officiels. Maison du Drapeau, au service de la nation.</p>
      </div>
    </div>
  </section>

  <!-- ============== VI · PRESTIGE ============== -->
  <section id="prestige" class="chapter chapter--ink" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="pr.num">VI — La Confiance</span>
      <hr class="gold-rule reveal d1" />
      <h2 class="chap-title reveal d1" data-i18n="pr.title">Grands projets, même exigence.</h2>
      <p class="lead reveal d2 measure" data-i18n="pr.lead">Des commandes officielles et institutionnelles réunies par la précision d’exécution et le respect du symbole.</p>
      {/* Populated at runtime by the inline script below from
          /api/v1/website/references. If Odoo has zero references, the
          whole section is hidden — same pattern as the partners /
          testimonials / FAQ bands. */}
      <div class="prestige-list" id="prestigeList">
        <div class="prestige-row reveal prestige-skel"></div>
        <div class="prestige-row reveal prestige-skel"></div>
        <div class="prestige-row reveal prestige-skel"></div>
      </div>

      <script is:inline data-astro-rerun>
        (async function () {
          if (document.readyState === "loading") {
            await new Promise(function (r) {
              document.addEventListener("DOMContentLoaded", r, { once: true });
            });
          }
          if (!window.BR_API) return;
          function esc(s) {
            if (s == null) return "";
            return String(s).replace(/[&<>"']/g, function (c) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
            });
          }
          async function render() {
            var list = document.getElementById("prestigeList");
            var section = document.getElementById("prestige");
            if (!list) return;
            try {
              var res = await window.BR_API.getReferences();
              var items = res.references || [];
              if (!items.length) { if (section) section.style.display = "none"; return; }
              if (section) section.style.display = "";
              // No `reveal` class: the scroll observer was set up before these
              // rows existed, so it would never fire `.in` on them and they'd
              // stay at opacity 0. Render them already visible instead.
              list.innerHTML = items.map(function (r) {
                var place = r.subtitle
                  ? '<span class="prestige-place">' + esc(r.subtitle) + '</span>'
                  : '';
                return '<div class="prestige-row">'
                  +    '<span class="prestige-yr">' + esc(r.year) + '</span>'
                  +    '<span class="prestige-name">' + esc(r.title) + '</span>'
                  +    place
                  +  '</div>';
              }).join("");
            } catch (err) {
              console.error("[BR] references fetch failed", err);
              if (section) section.style.display = "none";
            }
          }
          render();
          if (!window.__brReferencesLangBound) {
            window.__brReferencesLangBound = true;
            window.addEventListener("br:langchange", render);
          }
        })();
      </script>
    </div>
  </section>

  <!-- ============== VI · PARTNERS ============== -->
  <section id="partners" class="chapter chapter--ivory partners" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="pt.eyebrow">NOS CLIENTS</span>
      <hr class="gold-rule reveal d1" style="margin-inline:auto;" />
      <h2 class="chap-title reveal d1" data-i18n="pt.title">Des noms qui nous ont accordé leur confiance.</h2>
      <p class="lead reveal d2" data-i18n="pt.sub">Depuis 1986, Broderie Royale Algérie accompagne des organismes officiels et de grandes institutions à travers des produits textiles qui portent leur identité et honorent leur image.</p>
      {/* Populated at runtime by the inline script below from
          /api/v1/website/partners. Rendered as a seamless infinite
          horizontal marquee: the .partner-track child is built with
          the logo list duplicated end-to-end, then CSS translates the
          track by -50% over its full duration so it loops back to a
          visually-identical starting frame. Edges are masked so
          logos don't pop in/out abruptly. */}
      <div class="partner-marquee reveal d2" id="partnersGrid" aria-label="Nos clients">
        <div class="partner-track">
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
        </div>
      </div>

      <script is:inline data-astro-rerun>
        (async function () {
          // Initial load: scripts at the end of <body> haven't run yet, so
          // BR_API isn't defined. Wait for DOMContentLoaded. On a SPA nav
          // via ClientRouter, BR_API is already on window — readyState is
          // "interactive"/"complete", so we run immediately.
          if (document.readyState === "loading") {
            await new Promise(function (r) {
              document.addEventListener("DOMContentLoaded", r, { once: true });
            });
          }
          if (!window.BR_API) return;
          function esc(s) {
            if (s == null) return "";
            return String(s).replace(/[&<>"']/g, function (c) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
            });
          }
          async function render() {
            var grid = document.getElementById("partnersGrid");
            var section = document.getElementById("partners");
            if (!grid) return;
            try {
              var res = await window.BR_API.getPartners();
              var partners = res.partners || [];
              if (!partners.length) {
                if (section) section.style.display = "none";
                return;
              }
              if (section) section.style.display = "";
              function tileFor(p, hidden) {
                var img = '<img src="' + esc(p.logo_url) + '" alt="' + esc(p.name) + '" width="220" height="165" loading="lazy" decoding="async" />';
                var attrs = hidden ? ' aria-hidden="true" tabindex="-1"' : '';
                if (p.website_url) {
                  return '<a class="partner-tile" href="' + esc(p.website_url) + '" target="_blank" rel="noopener"' + attrs + '>' + img + '</a>';
                }
                return '<div class="partner-tile"' + attrs + '>' + img + '</div>';
              }
              // Seamless-marquee trick: emit the logo list twice back-to-back.
              // The CSS animation translates the track by -50% (= exactly one
              // copy's width), landing back at a frame indistinguishable from
              // the start — no visible jump.
              var first = partners.map(function (p) { return tileFor(p, false); }).join("");
              var dup   = partners.map(function (p) { return tileFor(p, true); }).join("");
              grid.innerHTML = '<div class="partner-track">' + first + dup + '</div>';
              // Speed proportional to number of logos so density feels
              // consistent. ~4s per logo * count = full loop duration.
              var seconds = Math.max(16, partners.length * 4);
              var track = grid.firstElementChild;
              if (track) track.style.setProperty("--marquee-duration", seconds + "s");
            } catch (err) {
              console.error("[BR] partners fetch failed", err);
              if (section) section.style.display = "none";
            }
          }
          render();
          // Re-render on language change. Guarded so Astro re-execution
          // doesn't stack multiple listeners.
          if (!window.__brPartnersLangBound) {
            window.__brPartnersLangBound = true;
            window.addEventListener("br:langchange", render);
          }
        })();
      </script>
    </div>
  </section>

