---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Broderie Royale Algérie — Maison du Drapeau"
  showOverture={true}
  storyEffects={true}
  isHero={true}
  emitLocalBusiness={true}
>
<main>

  <!-- ============== HERO ============== -->
  <section id="hero" data-thread-node>
    <div class="hero-bg">
      <video id="heroBg" autoplay muted loop playsinline poster="/assets/texture-embroidery-patch.webp">
        <source src="/assets/hero-loop.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-inner">
      <div class="hero-crest-wrap">
        <img class="hero-crest" id="heroCrestBase" src="/assets/hero-crest-base.png" alt="Broderie Royale Algérie" fetchpriority="high" />
        <img class="hero-crown" id="heroCrown" src="/assets/hero-crown.png" alt="" />
      </div>
      {/* Brand wordmark sits between the crest and the "MAISON DU DRAPEAU"
          eyebrow — same light variant the nav uses, so the lockup reads
          as a single piece in the hero. */}
      <img class="hero-wordmark" src="/assets/nav-wordmark-light.png" alt="Broderie Royale Algérie — Maison du Drapeau · depuis 1986" />
      <h1 class="hero-title" data-i18n="hero.title" data-i18n-html>La perfection <em>c’est notre métier.</em></h1>
      <p class="hero-sub" data-i18n="hero.sub">Communication visuelle par le textile de haute qualité. Drapeaux, écussons et broderie d’exception — signés en Algérie depuis près de quarante ans.</p>
    </div>
    <div class="scroll-hint">
      <span data-i18n="hero.scroll">Suivez le fil</span>
      <div class="dot"></div>
    </div>
  </section>

  <!-- ============== I · HERITAGE ============== -->
  <section id="heritage" class="chapter chapter--ivory" data-thread-node>
    <div class="wrap heritage-grid">
      <div>
        <span class="chap-num reveal" data-i18n="her.num">I — La Maison</span>
        <hr class="gold-rule reveal d1" />
        <h2 class="chap-title reveal d1" data-i18n="her.title">Une maison familiale de référence.</h2>
        <p class="lead reveal d2 measure" data-i18n="her.body">Depuis 1986, Broderie Royale Algérie cultive un savoir-faire rare : donner aux institutions, aux corps constitués et aux marques une identité textile durable, conçue pour marquer les esprits.</p>
        {/* Value chips: hover (desktop) or tap (mobile) reveals the client-
            approved short description. Chip stays compact; tooltip appears
            above with a smooth gold-thread swell — matching the brand's
            "detail reveals itself" tone. */}
        <div class="values-row reveal d3">
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v1">Expérience</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v1d">Un parcours familial depuis 1986 dans les drapeaux et les produits textiles officiels.</span>
          </span>
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v2">Qualité</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v2d">Des matières sélectionnées, des couleurs stables et une finalisation adaptée aux usages officiels.</span>
          </span>
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v3">Professionnalisme</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v3d">Une organisation claire des commandes, un suivi rigoureux et le respect des exigences de chaque institution.</span>
          </span>
          <span class="value-chip" tabindex="0">
            <span class="vc-name" data-i18n="her.v4">Maîtrise</span>
            <span class="vc-tip" role="tooltip" data-i18n="her.v4d">Une attention précise à chaque détail, du design au dernier point de broderie.</span>
          </span>
        </div>
      </div>
      <div class="stat-stack reveal d2">
        <div class="stat">
          <div class="stat-num" data-i18n="her.s1n">1986</div>
          <div class="stat-lab" data-i18n="her.s1l">L’année fondatrice</div>
        </div>
        <div class="stat">
          <div class="stat-num" data-i18n="her.s2n">40</div>
          <div class="stat-lab" data-i18n="her.s2l">Années de savoir-faire</div>
        </div>
        <div class="stat">
          <div class="stat-num" data-i18n="her.s3n">3</div>
          <div class="stat-lab" data-i18n="her.s3l">Maisons — Alger, Djelfa & Boumerdès</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== II · ATELIER ============== -->
  <section id="atelier" class="chapter chapter--ink atelier" data-thread-node>
    <div class="wrap atelier-grid">
      <div>
        <span class="chap-num reveal" data-i18n="at.num">II — Le Geste</span>
        <hr class="gold-rule reveal d1" />
        <h2 class="chap-title reveal d1" data-i18n="at.title">Le fil, l’aiguille, la main.</h2>
        <p class="lead reveal d2" data-i18n="at.body">Chaque écusson naît d’un geste précis, répété des milliers de fois. Le fil d’or épouse le tissu, point après point, jusqu’à révéler la couronne. La broderie est notre signature ; le détail, notre obsession.</p>
      </div>
      <div class="atelier-media reveal d1" data-parallax="0.12">
        <img src="/assets/photo-embroidery-machine.webp" alt="Broderie machine" width="1121" height="421" loading="lazy" decoding="async" />
        <div class="media-caption" data-i18n="at.cap">Broderie machine multi-têtes — Atelier d’Alger</div>
      </div>
    </div>
  </section>

  <!-- ============== III · METIERS (vertical card stack) ==============
       Each card is position:sticky/top:0/height:100vh. As the visitor
       scrolls, the next card slides UP and stacks over the previous
       one. scenes.js attaches a subtle scale-down + dim to the outgoing
       card so the new one feels like it's covering it (depth). -->
  <section id="metiers-pin" data-thread-node>
    <div class="metiers-stack-head">
      <span class="chap-num reveal" data-i18n="me.num">III — Les Métiers</span>
      <hr class="gold-rule reveal d1" />
      <h2 class="chap-title reveal d1" data-i18n="me.title">Cinq métiers, une exigence.</h2>
      <p class="lead reveal d2 measure" data-i18n="me.sub">Faites défiler pour découvrir chaque métier.</p>
    </div>
    <div class="metiers-stack" id="metiersStack">
      <article class="metier-stack-card" data-card="1">
        <div class="metier-stack-inner">
          <img src="/assets/photo-flag-international.webp" alt="" width="1144" height="767" loading="lazy" decoding="async" />
          <div class="metier-stack-body">
            <span class="metier-stack-idx">01</span>
            <h3 class="metier-stack-name" data-i18n="me.1n">Drapeaux</h3>
            <p class="metier-stack-desc" data-i18n="me.1d">Drapeaux nationaux, internationaux, de table et de mât, sur supports haute résistance.</p>
          </div>
        </div>
      </article>
      <article class="metier-stack-card" data-card="2">
        <div class="metier-stack-inner">
          <img src="/assets/texture-embroidery-patch.webp" alt="" width="960" height="540" loading="lazy" decoding="async" />
          <div class="metier-stack-body">
            <span class="metier-stack-idx">02</span>
            <h3 class="metier-stack-name" data-i18n="me.2n">Écussons</h3>
            <p class="metier-stack-desc" data-i18n="me.2d">Patches et insignes brodés, fil d’or sur tissu, pour corps et clubs.</p>
          </div>
        </div>
      </article>
      <article class="metier-stack-card" data-card="3">
        <div class="metier-stack-inner">
          <img src="/assets/photo-pennant.webp" alt="" width="1071" height="827" loading="lazy" decoding="async" />
          <div class="metier-stack-body">
            <span class="metier-stack-idx">03</span>
            <h3 class="metier-stack-name" data-i18n="me.3n">Fanions</h3>
            <p class="metier-stack-desc" data-i18n="me.3d">Fanions cérémoniels et décoratifs, frange dorée, finition main.</p>
          </div>
        </div>
      </article>
      <article class="metier-stack-card" data-card="4">
        <div class="metier-stack-inner">
          <img src="/assets/metier-broderie.webp" alt="" width="720" height="894" loading="lazy" decoding="async" />
          <div class="metier-stack-body">
            <span class="metier-stack-idx">04</span>
            <h3 class="metier-stack-name" data-i18n="me.4n">Broderie</h3>
            <p class="metier-stack-desc" data-i18n="me.4d">Personnalisation premium : polos, t-shirts, casquettes et vêtements de travail.</p>
          </div>
        </div>
      </article>
      <article class="metier-stack-card" data-card="5">
        <div class="metier-stack-inner">
          <img src="/assets/metier-polyester.webp" alt="" width="1200" height="896" loading="lazy" decoding="async" />
          <div class="metier-stack-body">
            <span class="metier-stack-idx">05</span>
            <h3 class="metier-stack-name" data-i18n="me.5n">Impression polyester</h3>
            <p class="metier-stack-desc" data-i18n="me.5d">Impression numérique sur tissu polyester, couleurs éclatantes et tenue durable.</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ============== IV · SERVE ==============
       Audience qualifier: tells the visitor "this is for you" right after
       the products. Originally sat after Prestige/Partners (between two
       trust signals); moved up so it splits product showcase from social
       proof instead of fragmenting the social proof itself. -->
  <section id="serve" class="chapter chapter--ivory" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="sv.num">IV — Au Service de</span>
      <hr class="gold-rule reveal d1" />
      <h2 class="chap-title reveal d1" data-i18n="sv.title">Au service de ceux qui représentent.</h2>
      <div class="serve-grid">
        <div class="serve-cell reveal"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M18 44 L50 26 L82 44"/><path pathLength="1" d="M22 44 L78 44"/><path pathLength="1" d="M28 46 L28 74"/><path pathLength="1" d="M42 46 L42 74"/><path pathLength="1" d="M58 46 L58 74"/><path pathLength="1" d="M72 46 L72 74"/><path pathLength="1" d="M20 74 L80 74"/><path pathLength="1" d="M14 80 L86 80"/><path pathLength="1" d="M50 9 L51.41 13.06 L55.71 13.15 L52.28 15.74 L53.53 19.85 L50 17.4 L46.47 19.85 L47.72 15.74 L44.29 13.15 L48.59 13.06 Z"/></svg><span class="sn">01</span><span class="serve-rule"></span><span class="st" data-i18n="sv.1">Corps constitués & institutions de l’État</span></div>
        <div class="serve-cell reveal d1"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M16 80 L84 80"/><path pathLength="1" d="M22 80 L22 56 L38 56 L38 80"/><path pathLength="1" d="M42 80 L42 40 L60 40 L60 80"/><path pathLength="1" d="M62 80 L62 60 L78 60 L78 80"/><path pathLength="1" d="M51 40 L51 30"/><path pathLength="1" d="M51 31 L61 33.5 L51 36"/></svg><span class="sn">02</span><span class="serve-rule"></span><span class="st" data-i18n="sv.2">Collectivités locales</span></div>
        <div class="serve-cell reveal d2"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M50 16 L76 26 L76 50 C76 66 64 76 50 82 C36 76 24 66 24 50 L24 26 Z"/><path pathLength="1" d="M38 48 L47 57 L64 38"/></svg><span class="sn">03</span><span class="serve-rule"></span><span class="st" data-i18n="sv.3">Sociétés de sécurité & de gardiennage</span></div>
        <div class="serve-cell reveal"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M28 62 A22 22 0 0 1 72 62"/><circle pathLength="1" cx="50" cy="34" r="2.6"/><path pathLength="1" d="M50 36.6 L50 40"/><path pathLength="1" d="M22 66 L78 66"/><path pathLength="1" d="M32 70 Q50 75 68 70"/></svg><span class="sn">04</span><span class="serve-rule"></span><span class="st" data-i18n="sv.4">Hôtels & restaurants</span></div>
        <div class="serve-cell reveal d1"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M38 34 L62 34 L60 50 C60 58 55 62 50 62 C45 62 40 58 40 50 Z"/><path pathLength="1" d="M38 36 C30 36 30 50 41 50"/><path pathLength="1" d="M62 36 C70 36 70 50 59 50"/><path pathLength="1" d="M50 62 L50 70"/><path pathLength="1" d="M40 70 L60 70"/><path pathLength="1" d="M36 76 L64 76"/></svg><span class="sn">05</span><span class="serve-rule"></span><span class="st" data-i18n="sv.5">Clubs sportifs</span></div>
        <div class="serve-cell reveal d2"><svg class="serve-motif" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M40 28 L26 40 L34 48 L34 76 L66 76 L66 48 L74 40 L60 28"/><path pathLength="1" d="M40 28 L50 38 L60 28"/><path pathLength="1" d="M50 38 L50 54"/></svg><span class="sn">06</span><span class="serve-rule"></span><span class="st" data-i18n="sv.6">Particuliers</span></div>
      </div>
    </div>
  </section>

  <!-- ============== V · FLAG ============== -->
  <section id="flag" data-thread-node>
    <div class="flag-media" data-parallax-bg>
      <img src="/assets/photo-flag-lobby.webp" alt="Drapeau algérien dans un hall de marbre" width="1536" height="1024" loading="lazy" decoding="async" />
    </div>
    <div class="flag-scrim"></div>
    <div class="flag-content">
      <div class="flag-inner">
        <span class="chap-num reveal" data-i18n="fl.num">V — Le Drapeau</span>
        <hr class="gold-rule reveal d1" />
        <h2 class="flag-quote reveal d1" data-i18n="fl.quote" data-i18n-html>Du salon d’honneur à la tribune officielle, nos drapeaux portent <em>haut les couleurs.</em></h2>
        <p class="lead reveal d2 mt-m" data-i18n="fl.body">Conception et fabrication de drapeaux institutionnels, événementiels et publicitaires. La Maison du Drapeau, au service de la Nation.</p>
      </div>
    </div>
  </section>

  <!-- ============== VI · PRESTIGE ============== -->
  <section id="prestige" class="chapter chapter--ink" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="pr.num">VI — La Confiance</span>
      <hr class="gold-rule reveal d1" />
      <h2 class="chap-title reveal d1" data-i18n="pr.title">Ils nous ont fait confiance.</h2>
      <p class="lead reveal d2 measure" data-i18n="pr.lead">Des commandes officielles et de grande envergure, portées par la même exigence.</p>
      {/* Populated at runtime by the inline script below from
          /api/v1/website/references. If Odoo has zero references, the
          whole section is hidden — same pattern as the partners /
          testimonials / FAQ bands. */}
      <div class="prestige-list" id="prestigeList">
        <div class="prestige-row reveal prestige-skel"></div>
        <div class="prestige-row reveal prestige-skel"></div>
        <div class="prestige-row reveal prestige-skel"></div>
      </div>

      <script is:inline data-astro-rerun>
        (async function () {
          if (document.readyState === "loading") {
            await new Promise(function (r) {
              document.addEventListener("DOMContentLoaded", r, { once: true });
            });
          }
          if (!window.BR_API) return;
          function esc(s) {
            if (s == null) return "";
            return String(s).replace(/[&<>"']/g, function (c) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
            });
          }
          async function render() {
            var list = document.getElementById("prestigeList");
            var section = document.getElementById("prestige");
            if (!list) return;
            try {
              var res = await window.BR_API.getReferences();
              var items = res.references || [];
              if (!items.length) { if (section) section.style.display = "none"; return; }
              if (section) section.style.display = "";
              // No `reveal` class: the scroll observer was set up before these
              // rows existed, so it would never fire `.in` on them and they'd
              // stay at opacity 0. Render them already visible instead.
              list.innerHTML = items.map(function (r) {
                var place = r.subtitle
                  ? '<span class="prestige-place">' + esc(r.subtitle) + '</span>'
                  : '';
                return '<div class="prestige-row">'
                  +    '<span class="prestige-yr">' + esc(r.year) + '</span>'
                  +    '<span class="prestige-name">' + esc(r.title) + '</span>'
                  +    place
                  +  '</div>';
              }).join("");
            } catch (err) {
              console.error("[BR] references fetch failed", err);
              if (section) section.style.display = "none";
            }
          }
          render();
          if (!window.__brReferencesLangBound) {
            window.__brReferencesLangBound = true;
            window.addEventListener("br:langchange", render);
          }
        })();
      </script>
    </div>
  </section>

  <!-- ============== VI · PARTNERS ============== -->
  <section id="partners" class="chapter chapter--ivory partners" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="pt.eyebrow">PARTENAIRES & RÉFÉRENCES</span>
      <hr class="gold-rule reveal d1" style="margin-inline:auto;" />
      <h2 class="chap-title reveal d1" data-i18n="pt.title">La confiance des institutions.</h2>
      <p class="lead reveal d2" data-i18n="pt.sub">Corps constitués, collectivités, clubs et grandes marques nous confient leur image depuis près de quarante ans.</p>
      {/* Populated at runtime by the inline script below from
          /api/v1/website/partners. Rendered as a seamless infinite
          horizontal marquee: the .partner-track child is built with
          the logo list duplicated end-to-end, then CSS translates the
          track by -50% over its full duration so it loops back to a
          visually-identical starting frame. Edges are masked so
          logos don't pop in/out abruptly. */}
      <div class="partner-marquee reveal d2" id="partnersGrid" aria-label="Nos clients">
        <div class="partner-track">
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
          <div class="partner-tile partner-skel"></div>
        </div>
      </div>

      <script is:inline data-astro-rerun>
        (async function () {
          // Initial load: scripts at the end of <body> haven't run yet, so
          // BR_API isn't defined. Wait for DOMContentLoaded. On a SPA nav
          // via ClientRouter, BR_API is already on window — readyState is
          // "interactive"/"complete", so we run immediately.
          if (document.readyState === "loading") {
            await new Promise(function (r) {
              document.addEventListener("DOMContentLoaded", r, { once: true });
            });
          }
          if (!window.BR_API) return;
          function esc(s) {
            if (s == null) return "";
            return String(s).replace(/[&<>"']/g, function (c) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
            });
          }
          async function render() {
            var grid = document.getElementById("partnersGrid");
            var section = document.getElementById("partners");
            if (!grid) return;
            try {
              var res = await window.BR_API.getPartners();
              var partners = res.partners || [];
              if (!partners.length) {
                if (section) section.style.display = "none";
                return;
              }
              if (section) section.style.display = "";
              function tileFor(p, hidden) {
                var img = '<img src="' + esc(p.logo_url) + '" alt="' + esc(p.name) + '" width="220" height="165" loading="lazy" decoding="async" />';
                var attrs = hidden ? ' aria-hidden="true" tabindex="-1"' : '';
                if (p.website_url) {
                  return '<a class="partner-tile" href="' + esc(p.website_url) + '" target="_blank" rel="noopener"' + attrs + '>' + img + '</a>';
                }
                return '<div class="partner-tile"' + attrs + '>' + img + '</div>';
              }
              // Seamless-marquee trick: emit the logo list twice back-to-back.
              // The CSS animation translates the track by -50% (= exactly one
              // copy's width), landing back at a frame indistinguishable from
              // the start — no visible jump.
              var first = partners.map(function (p) { return tileFor(p, false); }).join("");
              var dup   = partners.map(function (p) { return tileFor(p, true); }).join("");
              grid.innerHTML = '<div class="partner-track">' + first + dup + '</div>';
              // Speed proportional to number of logos so density feels
              // consistent. ~4s per logo * count = full loop duration.
              var seconds = Math.max(16, partners.length * 4);
              var track = grid.firstElementChild;
              if (track) track.style.setProperty("--marquee-duration", seconds + "s");
            } catch (err) {
              console.error("[BR] partners fetch failed", err);
              if (section) section.style.display = "none";
            }
          }
          render();
          // Re-render on language change. Guarded so Astro re-execution
          // doesn't stack multiple listeners.
          if (!window.__brPartnersLangBound) {
            window.__brPartnersLangBound = true;
            window.addEventListener("br:langchange", render);
          }
        })();
      </script>
    </div>
  </section>

  <!-- ============== VI·c · TESTIMONIALS ============== -->
  <section id="testimonials" class="chapter chapter--ink testimonials" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="ts.eyebrow">TÉMOIGNAGES</span>
      <hr class="gold-rule reveal d1" style="margin-inline:auto;" />
      <h2 class="chap-title reveal d1" data-i18n="ts.title">La voix de nos clients.</h2>
      <p class="lead reveal d2" data-i18n="ts.sub">Quelques retours de ceux qui nous ont confié leur identité textile.</p>

      {/* Populated by inline script. Hidden entirely if Odoo returns no
          testimonials. Same pattern as the partners band above. */}
      <div class="testimonial-grid reveal d2" id="testimonialsGrid">
        <div class="testimonial-card testimonial-skel"></div>
        <div class="testimonial-card testimonial-skel"></div>
        <div class="testimonial-card testimonial-skel"></div>
      </div>

      <script is:inline data-astro-rerun>
        (async function () {
          if (document.readyState === "loading") {
            await new Promise(function (r) {
              document.addEventListener("DOMContentLoaded", r, { once: true });
            });
          }
          if (!window.BR_API) return;
          function esc(s) {
            if (s == null) return "";
            return String(s).replace(/[&<>"']/g, function (c) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
            });
          }
          function nl2br(s) { return esc(s).replace(/\n/g, "<br/>"); }
          function stars(n) {
            n = Math.max(0, Math.min(5, parseInt(n, 10) || 0));
            if (!n) return "";
            var s = "";
            for (var i = 0; i < 5; i++) s += '<span class="tst-star ' + (i < n ? "on" : "") + '">★</span>';
            return '<div class="tst-stars">' + s + '</div>';
          }
          async function render() {
            var grid = document.getElementById("testimonialsGrid");
            var section = document.getElementById("testimonials");
            if (!grid) return;
            try {
              var res = await window.BR_API.getTestimonials();
              var items = res.testimonials || [];
              if (!items.length) { if (section) section.style.display = "none"; return; }
              if (section) section.style.display = "";
              grid.innerHTML = items.map(function (t) {
                var photo = t.author_photo_url
                  ? '<img class="tst-photo" src="' + esc(t.author_photo_url) + '" alt="' + esc(t.author) + '" width="44" height="44" loading="lazy" decoding="async" />'
                  : '<div class="tst-photo tst-photo-blank">' + esc((t.author || "?").slice(0, 1).toUpperCase()) + '</div>';
                var role = t.author_role ? '<div class="tst-role">' + esc(t.author_role) + '</div>' : "";
                return '<article class="testimonial-card">'
                  +    '<div class="tst-mark" aria-hidden="true">&ldquo;</div>'
                  +    '<blockquote class="tst-quote">' + nl2br(t.quote) + '</blockquote>'
                  +    stars(t.rating)
                  +    '<footer class="tst-author">'
                  +      photo
                  +      '<div class="tst-meta"><div class="tst-name">' + esc(t.author) + '</div>' + role + '</div>'
                  +    '</footer>'
                  +  '</article>';
              }).join("");
            } catch (err) {
              console.error("[BR] testimonials fetch failed", err);
              if (section) section.style.display = "none";
            }
          }
          render();
          if (!window.__brTestimonialsLangBound) {
            window.__brTestimonialsLangBound = true;
            window.addEventListener("br:langchange", render);
          }
        })();
      </script>
    </div>
  </section>

  <!-- ============== VI·d · FAQ ============== -->
  <section id="faq" class="chapter chapter--ivory faq" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="fq.eyebrow">QUESTIONS FRÉQUENTES</span>
      <hr class="gold-rule reveal d1" style="margin-inline:auto;" />
      <h2 class="chap-title reveal d1" data-i18n="fq.title">Bon à savoir.</h2>
      <p class="lead reveal d2 measure" style="margin:0 auto" data-i18n="fq.sub">Les réponses aux questions que l'on nous pose le plus souvent.</p>

      <div class="faq-list reveal d2" id="faqList">
        <div class="faq-item faq-skel"></div>
        <div class="faq-item faq-skel"></div>
        <div class="faq-item faq-skel"></div>
      </div>

      <script is:inline data-astro-rerun>
        (async function () {
          if (document.readyState === "loading") {
            await new Promise(function (r) {
              document.addEventListener("DOMContentLoaded", r, { once: true });
            });
          }
          if (!window.BR_API) return;
          function esc(s) {
            if (s == null) return "";
            return String(s).replace(/[&<>"']/g, function (c) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
            });
          }
          function nl2br(s) { return esc(s).replace(/\n/g, "<br/>"); }
          async function render() {
            var list = document.getElementById("faqList");
            var section = document.getElementById("faq");
            if (!list) return;
            try {
              var res = await window.BR_API.getFaq();
              var items = res.faq || [];
              if (!items.length) { if (section) section.style.display = "none"; return; }
              if (section) section.style.display = "";
              list.innerHTML = items.map(function (f, i) {
                return '<details class="faq-item"' + (i === 0 ? " open" : "") + '>'
                  +    '<summary class="faq-q"><span class="faq-q-text">' + esc(f.question) + '</span><span class="faq-toggle" aria-hidden="true"></span></summary>'
                  +    '<div class="faq-a">' + nl2br(f.answer) + '</div>'
                  +  '</details>';
              }).join("");
            } catch (err) {
              console.error("[BR] faq fetch failed", err);
              if (section) section.style.display = "none";
            }
          }
          render();
          if (!window.__brFaqLangBound) {
            window.__brFaqLangBound = true;
            window.addEventListener("br:langchange", render);
          }
        })();
      </script>
    </div>
  </section>

  <!-- ============== VII · CATALOGUE / CONTACT ============== -->
  <section id="catalogue" class="chapter chapter--ink" data-thread-node>
    <div class="wrap">
      <span class="chap-num reveal" data-i18n="ca.num">VII — Le Catalogue</span>
      <hr class="gold-rule reveal d1" style="margin-inline:auto;" />
      <h2 class="chap-title reveal d1" data-i18n="ca.title">Explorez le catalogue.</h2>
      <p class="lead reveal d2" style="max-width:60ch;margin:0 auto;" data-i18n="ca.lead">Six familles de produits, un seul niveau d’exigence. Donnez à votre identité une visibilité d’exception.</p>

      <button class="btn-royal reveal d2" onclick="location.href='/boutique'">
        <span data-i18n="ca.cta">Explorer le guide</span>
        <span class="ar"></span>
      </button>
    </div>
  </section>

  {/* ============== Métier video lightbox ==============
       Click any .metier-stack-inner in section III to open a YouTube video
       inside this modal. iframe src is set on open and cleared on
       close so playback stops cleanly and we don't keep a hidden
       YouTube tab loaded. CSP allows www.youtube-nocookie.com via
       the frame-src directive in nginx.conf + the meta CSP. */}
  <div id="metierVideo" class="metier-video" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Vidéo métier">
    <button class="metier-video-close" type="button" aria-label="Fermer la vidéo">&times;</button>
    <div class="metier-video-frame">
      <iframe title="Vidéo métier" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>
    </div>
  </div>

</main>

<script is:inline data-astro-rerun>
  /* Métier video lightbox — opens the same placeholder YouTube clip for
     every card for now; once each métier gets its own video the VIDEO_ID
     constant becomes a per-card data-attribute lookup. */
  (function () {
    var modal = document.getElementById('metierVideo');
    if (!modal) return;
    var iframe = modal.querySelector('iframe');
    var closeBtn = modal.querySelector('.metier-video-close');
    var VIDEO_ID = 'Rc_v6MdkgH4';
    function open(e) {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + VIDEO_ID + '?autoplay=1&rel=0&modestbranding=1';
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }
    function close() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      iframe.src = '';
      document.body.style.overflow = '';
    }
    /* Click target is the inner card rectangle, not the whole 100vh sticky
       section — otherwise the entire viewport-sized .metier-stack-card
       would act as a hot zone when the card is pinned at top. */
    document.querySelectorAll('.metier-stack-inner').forEach(function (card) {
      if (card.dataset.videoBound) return;
      card.dataset.videoBound = '1';
      card.style.cursor = 'pointer';
      card.addEventListener('click', open);
    });
    if (!modal.dataset.bound) {
      modal.dataset.bound = '1';
      closeBtn.addEventListener('click', close);
      modal.addEventListener('click', function (e) {
        if (e.target === modal) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.classList.contains('open')) close();
      });
    }
  })();
</script>
</BaseLayout>
