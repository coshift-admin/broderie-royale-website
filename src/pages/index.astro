                var role = t.author_role ? '<div class="tst-role">' + esc(t.author_role) + '</div>' : "";
                return '<article class="testimonial-card">'
                  +    '<div class="tst-mark" aria-hidden="true">&ldquo;</div>'
                  +    '<blockquote class="tst-quote">' + nl2br(t.quote) + '</blockquote>'
                  +    stars(t.rating)
                  +    '<footer class="tst-author">'
                  +      photo
                  +      '<div class="tst-meta"><div class="tst-name">' + esc(t.author) + '</div>' + role + '</div>'
                  +    '</footer>'
                  +  '</article>';
              }).join("");
            } catch (err) {
              console.error("[BR] testimonials fetch failed", err);
              if (section) section.style.display = "none";
            }
          }
          render();
          if (!window.__brTestimonialsLangBound) {
            window.__brTestimonialsLangBound = true;
            window.addEventListener("br:langchange", render);
          }
        })();
      </script>
