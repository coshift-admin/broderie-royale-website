            });
          }
          function nl2br(s) { return esc(s).replace(/\n/g, "<br/>"); }
          function stars(n) {
            n = Math.max(0, Math.min(5, parseInt(n, 10) || 0));
            if (!n) return "";
            var s = "";
            for (var i = 0; i < 5; i++) s += '<span class="tst-star ' + (i < n ? "on" : "") + '">★</span>';
