---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  ogTitle?: string;
  description?: string;
  bodyClass?: string;
  dataPage?: string;
  /** Show the opening overture screen (index only) */
  showOverture?: boolean;
  /** Load GSAP/ScrollTrigger, scenes.js, effects.js, image-slot.js, particles canvas, thread track */
  storyEffects?: boolean;
  /** Use the scroll-to-hero div nav-brand variant instead of an anchor (index only) */
  isHero?: boolean;
  /** Set to true on /confirmation, /panier, /404, /motifs so search engines skip them */
  noindex?: boolean;
  /** Set to true on the homepage to emit the LocalBusiness JSON-LD block */
  emitLocalBusiness?: boolean;
}

const {
  title,
  ogTitle = title,
  description = "Broderie Royale Algérie — Maison du Drapeau, depuis 1986. Drapeaux, écussons et broderie d'exception.",
  bodyClass,
  dataPage,
  showOverture = false,
  storyEffects = false,
  isHero = false,
  noindex = false,
  emitLocalBusiness = false,
} = Astro.props;

// Site origin — change to the production domain at deploy time.
// Used to build absolute URLs for canonical, og:url, hreflang, sitemap.
const SITE = "https://broderieroyale.com";
const pathname = Astro.url.pathname;
const canonicalUrl = SITE + (pathname === "/" ? "/" : pathname.replace(/\/$/, ""));
---
<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{/* ----- Security headers (also enforce these at the reverse proxy in production) -----
   CSP keeps 'unsafe-inline' for now because we use inline <script> in contact/galerie/motifs
   and onclick handlers in index. Tighten with nonces or hashes in a future pass.
   connect-src 'self' must be widened to your Odoo origin before wiring Odoo.       */}
{/* `frame-ancestors` and `X-Frame-Options` are intentionally NOT in the
    <meta> CSP — browsers ignore them there and emit a console warning. Set
    them at your reverse proxy in production (Nginx: `add_header
    X-Frame-Options "SAMEORIGIN"` + a Content-Security-Policy header that
    repeats this <meta>'s directives plus `frame-ancestors 'self'`). */}
{/* `upgrade-insecure-requests` removed — when the storefront is served
   over plain HTTP (the validation phase on port 8090), that directive
   makes the browser request every same-origin asset as HTTPS, which
   404s. Re-add it once a TLS cert is on the public origin. */}
{/* Belt-and-braces: the authoritative CSP is sent as an HTTP header by
    nginx (see docker/nginx.conf). The browser still honours this <meta>
    form for tooling that can't inspect headers; keep the directives in
    sync between the two. */}
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: https://erp.broderieroyale.com; media-src 'self'; connect-src 'self' https://erp.broderieroyale.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; form-action 'self'; base-uri 'self'; object-src 'none';" />
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<link rel="apple-touch-icon" href="/assets/favicon.png" />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<link rel="canonical" href={canonicalUrl} />
{/* hreflang block — tells Google the same logical page exists in three
    languages. Currently language is switched client-side via the FR/AR/EN
    toggle, so all three hreflangs point at the same URL with a ?lang=
    query. When you move to URL-based locales (/en/, /ar/), update these. */}
<link rel="alternate" hreflang="fr" href={canonicalUrl} />
<link rel="alternate" hreflang="ar" href={canonicalUrl + (canonicalUrl.includes('?') ? '&' : '?') + 'lang=ar'} />
<link rel="alternate" hreflang="en" href={canonicalUrl + (canonicalUrl.includes('?') ? '&' : '?') + 'lang=en'} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={SITE + "/assets/og-card.png"} />
<meta property="og:site_name" content="Broderie Royale Algérie" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:locale:alternate" content="ar_DZ" />
<meta property="og:locale:alternate" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={SITE + "/assets/og-card.png"} />
<title>{title}</title>
{/* Fonts are self-hosted in /fonts/ (Optima, Mashq, Amiri) — no
    third-party CDN preconnect needed. brand.css owns the @font-face
    declarations. Note: do NOT preload the Optima WOFF2 here. Tried
    it once; on mobile slow-4G the font fetch competed with the CSS
    files for the narrow downlink and pushed Speed Index from 1.7s
    to 6.6s. The font fallback (Palatino) paints fine while Optima
    arrives in the background. */}
{/* Critical CSS — must block first paint: typography vars + font-face
    (brand.css), page layout (site.css), and the cursor/stitch reveal
    rules (luxe.css). All three are referenced from above-the-fold DOM. */}
<link rel="stylesheet" href="/brand.css" />
<link rel="stylesheet" href="/site.css" />
<link rel="stylesheet" href="/luxe.css" />
{/* Non-critical CSS — defer on pages that don't render shop UI. shop.css
    styles only the boutique, cart, contact-card, and order pages; the
    homepage and other story pages never need it for first paint. We use
    the Filament Group `media="print" onload` pattern: the browser still
    downloads in parallel but doesn't block render, then swaps to media=all
    once loaded. <noscript> fallback restores the blocking behaviour for
    users with JS off so styling still applies. */}
{storyEffects ? (
  <>
    <link rel="stylesheet" href="/shop.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/shop.css" /></noscript>
  </>
) : (
  <link rel="stylesheet" href="/shop.css" />
)}
<ClientRouter />
<slot name="head" />
{/* Organization JSON-LD — always emit. Helps Google build the knowledge
    panel and surface contact info in search results. */}
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Broderie Royale Algérie",
  "alternateName": "Maison du Drapeau",
  "url": SITE,
  "logo": SITE + "/assets/logo-crest-color.png",
  "foundingDate": "1986",
  "description": description,
  "sameAs": [],
  "contactPoint": [{
    "@type": "ContactPoint",
    "telephone": "+213-23-82-30-81",
    "contactType": "customer service",
    "areaServed": "DZ",
    "availableLanguage": ["French", "Arabic", "English"]
  }]
})} />
{/* LocalBusiness JSON-LD — homepage only. Drives Google Maps / local-pack
    listings for the Alger showroom. */}
{emitLocalBusiness && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Broderie Royale Algérie",
    "image": SITE + "/assets/logo-crest-color.png",
    "url": SITE,
    "telephone": "+213-23-82-30-81",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Lotissement Soufflerie n°12, Dar El-Beïda",
      "addressLocality": "Alger",
      "postalCode": "16100",
      "addressCountry": "DZ"
    },
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday","Sunday","Monday","Tuesday","Wednesday","Thursday"],
      "opens": "09:00",
      "closes": "17:00"
    }]
  })} />
)}
</head>
<body class={bodyClass} data-page={dataPage}>

{showOverture && (
  <div id="overture">
    <img class="overture-crest" src="/assets/logo-crest-white.png" alt="Broderie Royale crest" decoding="async" />
    <div class="overture-line" data-i18n="ov.line">MAISON DU DRAPEAU · DEPUIS 1986</div>
  </div>
)}

{storyEffects && (
  <div class="progress-rail"><div class="progress-fill" id="progressFill"></div></div>
)}

<nav class="nav" id="nav">
  {isHero ? (
    <div class="nav-brand" data-goto="hero">
      <img class="nb-crest" src="/assets/nav-crest.png" alt="BR" width="794" height="853" />
      <img class="nb-mark" src="/assets/nav-wordmark-light.png" alt="Broderie Royale Algérie — Maison du Drapeau" width="1440" height="429" />
    </div>
  ) : (
    <a class="nav-brand" href="/" style="text-decoration:none">
      <img class="nb-crest" src="/assets/nav-crest.png" alt="BR" width="794" height="853" />
      <img class="nb-mark" src="/assets/nav-wordmark-light.png" alt="Broderie Royale Algérie — Maison du Drapeau" width="1440" height="429" />
    </a>
  )}
  <div class="nav-links">
    {isHero ? (
      <span class="nav-link" data-goto="heritage" data-i18n="nav.histoire">L'Histoire</span>
    ) : (
      <a class="nav-link" href="/" data-i18n="nav.histoire">L'Histoire</a>
    )}
    <a class="nav-link" href="/galerie" data-i18n="nav.galerie">Galerie</a>
    <a class="nav-link" href="/boutique" data-i18n="nav.boutique">Boutique</a>
    <a class="nav-link" href="/contact" data-i18n="nav.contact">Contact</a>
  </div>
  <div style="display:flex;align-items:center;gap:10px">
    <div class="lang-switch">
      <button class="lang-btn" data-lang="fr">FR</button>
      <button class="lang-btn" data-lang="en">EN</button>
      <button class="lang-btn" data-lang="ar">ع</button>
    </div>
    <a class="cart-icon" href="/panier" aria-label="Panier">
      {/* Shopping-cart (chariot) icon: handle on the left, basket body,
          two wheels. Client previously found the prior icon too close to
          a trash-bin silhouette. */}
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 4h2.2l1.3 2h13.2l-2 8.5H7.5L5.5 4z" stroke-linejoin="round"/>
        <circle cx="9" cy="19" r="1.5"/>
        <circle cx="17" cy="19" r="1.5"/>
      </svg>
      <span class="cart-count">0</span>
    </a>
    {/* Hamburger — visible only below 900px (see site.css .nav-toggle). */}
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mobileMenu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</nav>

{/* Fullscreen mobile drawer — same links as desktop, populated by i18n via [data-i18n].
    Lang buttons share the .lang-btn class so i18n.js initLang() binds them too. */}
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mm-links">
    <a class="mm-link" href="/" data-i18n="nav.histoire">L'Histoire</a>
    <a class="mm-link" href="/galerie" data-i18n="nav.galerie">Galerie</a>
    <a class="mm-link" href="/boutique" data-i18n="nav.boutique">Boutique</a>
    <a class="mm-link" href="/contact" data-i18n="nav.contact">Contact</a>
  </div>
  <div class="mm-lang">
    <button class="lang-btn" data-lang="fr">FR</button>
    <button class="lang-btn" data-lang="en">EN</button>
    <button class="lang-btn" data-lang="ar">ع</button>
  </div>
</div>

{storyEffects && (
  <>
    <canvas id="particles"></canvas>
    <div class="thread-track" id="threadTrack" aria-hidden="true"></div>
  </>
)}

<slot />

<footer class="footer-banner">
  {/* Single full-lockup logo (crest + wordmark + AR + tagline in one
      file). Replaces the two-part crest+wordmark stack whose relative
      proportions ended up wrong — using the actual brand lockup keeps
      the crest-to-text ratio the way the identity was designed. */}
  <img class="fb-logo" src="/assets/logo-full-ivory.png" alt="Broderie Royale Algérie — Maison du Drapeau · depuis 1986" width="1440" height="1315" loading="lazy" decoding="async" />
  {/* Contact + social row — icon links matching the brand identity
      (ivory strokes with a gold-lift on hover). Each link exposes an
      aria-label for screen readers and a data-tooltip attribute that
      the CSS renders as a small pill above the icon on hover. Social
      URLs are placeholders wired to the expected handle (@broderieroyale)
      until the client provides the definitive account URLs. */}
  <div class="fb-contact">
    <a href="https://broderieroyale.com" aria-label="Website" data-tooltip="broderieroyale.com" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14 0 18M12 3c-3 3.5-3 14 0 18"/></svg>
    </a>
    <a href="mailto:info@broderieroyale.com" aria-label="Email" data-tooltip="info@broderieroyale.com">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.6"/><path d="M3.5 6l8.5 6.5L20.5 6"/></svg>
    </a>
    <a href="tel:+213560949944" aria-label="Phone" data-tooltip="+213 560 94 99 44">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
    </a>
    {/* Two WhatsApp numbers per client — primary (mobile) + secondary
        (landline). Two icons keeps each number tappable directly instead
        of asking users to pick from a tooltip they can't click. */}
    <a href="https://wa.me/213660203044" aria-label="WhatsApp — 0660 20 30 44" data-tooltip="0660 20 30 44" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.7L3 21l4.5-1.2A9 9 0 1 0 12 3z"/><path d="M8.8 8.4c.6-.6 1.5-.6 2.1 0l.5.5c.4.4.4 1 0 1.4l-.4.4a5 5 0 0 0 2.8 2.8l.4-.4c.4-.4 1-.4 1.4 0l.5.5c.6.6.6 1.5 0 2.1a3 3 0 0 1-2.9.8 8 8 0 0 1-5.2-5.2 3 3 0 0 1 .8-2.9z"/></svg>
    </a>
    <a href="https://wa.me/213560939944" aria-label="WhatsApp — 0560 93 99 44" data-tooltip="0560 93 99 44" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.7L3 21l4.5-1.2A9 9 0 1 0 12 3z"/><path d="M8.8 8.4c.6-.6 1.5-.6 2.1 0l.5.5c.4.4.4 1 0 1.4l-.4.4a5 5 0 0 0 2.8 2.8l.4-.4c.4-.4 1-.4 1.4 0l.5.5c.6.6.6 1.5 0 2.1a3 3 0 0 1-2.9.8 8 8 0 0 1-5.2-5.2 3 3 0 0 1 .8-2.9z"/></svg>
    </a>
    <span class="fb-sep" aria-hidden="true"></span>
    <a href="https://www.facebook.com/share/1BSKu57auV/?mibextid=wwXIfr" aria-label="Facebook" data-tooltip="Facebook" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h2V5h-2.5A3.5 3.5 0 0 0 10 8.5V11H8v3h2v7h3v-7h2.2l.5-3H13V8.6c0-.4.3-.6.6-.6H14z"/></svg>
    </a>
    <a href="https://www.instagram.com/broderie_royale_algerie/" aria-label="Instagram" data-tooltip="Instagram" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href="https://www.tiktok.com/@broderieroyale_algerie" aria-label="TikTok" data-tooltip="TikTok" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v10.5a2.8 2.8 0 1 1-2.8-2.8" stroke-linecap="round"/><path d="M14 3c.2 2 1.7 3.6 3.8 4" stroke-linecap="round"/></svg>
    </a>
    <a href="https://www.youtube.com/@broderieroyalealgerie691" aria-label="YouTube" data-tooltip="YouTube" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="3"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href="https://dz.linkedin.com/company/broderie-royale-algerie" aria-label="LinkedIn" data-tooltip="LinkedIn" target="_blank" rel="noopener">
      {/* LinkedIn: rounded square, small "in" dot + vertical bar, single-
          curve "n" glyph. Stroked to match every other footer icon. */}
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2.4"/><path d="M8 10v7"/><circle cx="8" cy="7" r="1" fill="currentColor" stroke="none"/><path d="M12 17v-7M12 13c0-1.7 1-3 2.6-3s2.4 1.2 2.4 3v4"/></svg>
    </a>
  </div>
  <div class="fb-legal" data-i18n="fb.legal">© Broderie Royale Algérie — Tous droits réservés.</div>
  <div class="fb-credit">
    <a class="fc-row" href="https://coshift.agency" target="_blank" rel="noopener">
      <span class="fc-label" data-i18n="fb.credit">Conçu & développé par</span>
      <img class="fc-logo" src="/assets/coshift-logo-white.png" alt="Coshift" loading="lazy" decoding="async" />
    </a>
  </div>
</footer>

{/* Mobile-nav toggle. Inline + data-astro-rerun so it re-binds to the fresh
    nav DOM after every ClientRouter navigation. */}
<script is:inline data-astro-rerun>
  (function(){
    var t = document.getElementById('navToggle');
    var m = document.getElementById('mobileMenu');
    if (!t || !m) return;
    function setOpen(o){
      m.classList.toggle('open', o);
      m.setAttribute('aria-hidden', o ? 'false' : 'true');
      t.setAttribute('aria-expanded', o ? 'true' : 'false');
      document.body.classList.toggle('mobile-menu-open', o);
    }
    t.addEventListener('click', function(){ setOpen(!m.classList.contains('open')); });
    m.querySelectorAll('.mm-link').forEach(function(a){
      a.addEventListener('click', function(){ setOpen(false); });
    });
    // Close on Esc
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && m.classList.contains('open')) setOpen(false);
    });
  })();
</script>

{/* Per-page scripts: data-astro-rerun so they re-execute after each ClientRouter
    navigation (otherwise they would only run on the very first page load and the
    cart/products/i18n would be dead on every subsequent page). Library scripts
    (GSAP, Lenis) load once and are reused across navigations. */}
{storyEffects ? (
  <>
    <script is:inline src="/image-slot.js" data-astro-rerun></script>
    <script is:inline src="/js/config.js"></script>
    <script is:inline src="/js/api.js"></script>
    <script is:inline src="/js/i18n.js" data-astro-rerun></script>
    <script is:inline src="/js/shop-data.js" data-astro-rerun></script>
    <script is:inline src="/js/shop.js" data-astro-rerun></script>
    {/* GSAP / ScrollTrigger / Lenis MUST load before scenes.js / smooth.js /
        luxe.js / effects.js below — those reference window.gsap and
        window.Lenis synchronously. `defer` broke that ordering and killed
        the métiers horizontal-pin scroll, so we leave these blocking.
        They're tiny relative to the rest of the page now that images are
        WebP, so the perf cost is minor. */}
    <script is:inline src="/js/vendor/gsap.min.js"></script>
    <script is:inline src="/js/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/vendor/lenis.min.js"></script>
    <script is:inline src="/js/smooth.js" data-astro-rerun></script>
    <script is:inline src="/js/luxe.js" data-astro-rerun></script>
    <script is:inline src="/js/effects.js" data-astro-rerun></script>
    <script is:inline src="/js/scenes.js" data-astro-rerun></script>
  </>
) : (
  <>
    <script is:inline src="/js/vendor/lenis.min.js"></script>
    <script is:inline src="/js/smooth.js" data-astro-rerun></script>
    <script is:inline src="/js/luxe.js" data-astro-rerun></script>
    <script is:inline src="/js/config.js"></script>
    <script is:inline src="/js/api.js"></script>
    <script is:inline src="/js/file-picker.js"></script>
    <script is:inline src="/js/i18n.js" data-astro-rerun></script>
    {/* Fuse.js (basic build, ~6 KB gzipped) powers the boutique's
        fuzzy product search. Loaded ahead of shop.js because the
        renderer references window.Fuse synchronously. */}
    <script is:inline src="/js/vendor/fuse.min.js"></script>
    <script is:inline src="/js/shop-data.js" data-astro-rerun></script>
    <script is:inline src="/js/shop.js" data-astro-rerun></script>
  </>
)}

</body>
</html>
